[ DroneLogic d dir next_room charger_loc battery; 
if (d.is_active == 0 || power_restored == 0) return;    
    charger_loc = parent(DroneCharger);
    battery = child(DroneCharger);
! --- NEW: If the drone is docked, it is "asleep" and cannot spot you ---
    if (parent(d) == charger_loc && d.move_count > 15) return;
    ! 1. ARE YOU IN THE ROOM?
    if (parent(d) == location) {
        ! If it saw you last turn: CATCH
        if (d.drone_alert == 1) {
            CapturePlayer(); 
            d.drone_alert = 0; 
            return;
        }

        ! If it just saw you now: SPOT
        if (player_hidden == 1) {
            print "^The drone hovers past, missing you in the shadows.^";
            d.drone_alert = 0;
        } else {
            print "^^THE DRONE SPOTS YOU! Its red eye flares.^Your instincts scream: RUN!^";
            d.drone_alert = 1;
            return; ! Stop here so the player can run
        }
    }

    ! 2. CHARGING (Staggered by the move_count we set above)
    d.drone_alert = 0;
    d.move_count++;

    if (d.move_count > 15) {
        if (parent(d) == charger_loc) {
            if (battery ~= 0 && battery.charged == 1) {
                d.move_count = 0; ! Reset battery
                if (location == charger_loc) print "^The drone docks to recharge.^";
            }
            return; 
        } else {
            move d to charger_loc;
            if (parent(d) == location) print "^The drone floats in to charge.^";
            return;
        }
    }

    ! 3. MOVE RANDOMLY
    dir = random(6); 
    switch(dir) {
        1: next_room = (parent(d)).n_to; 2: next_room = (parent(d)).s_to;
        3: next_room = (parent(d)).e_to; 4: next_room = (parent(d)).w_to;
        5: next_room = (parent(d)).u_to; 6: next_room = (parent(d)).d_to;
    }
    
    if (next_room ~= 0 && metaclass(next_room) == Object && next_room has light) {
        move d to next_room;
    }

    ! 4. WARNINGS
    if (parent(d) == location) {
        print "^Suddenly, a security drone floats into the room!^";
    } else if (parent(d) == location.n_to || parent(d) == location.s_to ||
               parent(d) == location.e_to || parent(d) == location.w_to) {
        print "^You hear the unmistakable hum of a security drone nearby.^";
    }
];
! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
[ DroneDaemon d;
    objectloop (d ofclass SecurityDrone) {
        DroneLogic(d);
    }
];

[ CapturePlayer i next_obj;
    ! 1. Safe Inventory Strip
    i = child(player);
    while (i ~= nothing) {
        next_obj = sibling(i); ! Bookmark the next item
        move i to EvidenceLocker;
        i = next_obj;           ! Jump to the bookmark
    }

    ! 2. System Malfunctions (50/50)
if (visual_cortex_active == 1 && random(100) <= 50) {
    visual_cortex_active = 0;
    move installed_optical_chip to EvidenceLocker;
    print "Your vision blurs and swims disorientingly. ^";
}

if (audio_codec_active == 1 && random(100) <= 50) {
    audio_codec_active = 0;
    move installed_audio_chip to EvidenceLocker;
    print "A muffled ringing sound fills your ears for a moment, then fades. ^";
}

    ! 3. Teleport and Dialogue
    PlayerTo(Brig);
    brig_timer = 3;
    StartDaemon(Brig);
    
    ! 4. Dialogue Logic
    if (arpi_active == 0) {
        arpi_active = 1;
        new_line;
        print "A crackle of static erupts from the intercom, followed by a new voice. Not the administrative bark of the ship, but something that sounds like it wants to communicate.^";
        new_line;
        style underline;
        TranslateAudio("~Domn zraavek i Jadroz-Pohyb, po y Zgrt-Ulmk zraav y Tlkzvsk. Dronz zraavek i Vzrac. Scern za i Dronz... ne. Domn ne zraavek Vzrac, ak? Jadrozuzh?~^",
                    "~You should be able to hear my voice now, but this little episode will cost you. The drone has figured out you're here, so we have to figure out how to disable it and... wait a minute, you have no idea what I'm saying do you? Hello?~^");
        style roman;
    } else {
        new_line;
        print "The intercom clicks on immediately...^";
        new_line;
        style underline;
        ArpiBrig1(); 
        style roman;
    }
if (child(EvidenceLocker) ~= nothing) {
        give EvidenceLocker ~open locked;
        StartDaemon(EvidenceLocker); ! Start the 'watchdog' to see when it's emptied
    }
];
! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
[ ArpiNarrative unaware_str aware_str;
    if (arpi_aware == 0) {
        print (string) unaware_str;
    } else {
        print (string) aware_str;
    }
];
! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
[ TimePasses;
    turn_count++;
    DroneDaemon();
    ZerakthynAtmosphere();
    if (power_restored == 0) {
        oxygen = oxygen - 1;
        if (oxygen == 15) print "^Your lungs burn. The air is getting thin...^";
        if (oxygen <= 0) {
            deadflag = 1;
            print "^^Black spots fill your vision. You gasp for air that isn't there. Collapse.^";
        }
        if (alarm_lights_active == 1) {
            if (Mod(turn_count, 2) == 0) {
                print "^Red alarm lights flash! A siren sounds! A voice booms!^";
                new_line;
                style underline;
                print "~KRZHDYN: STAVR! DRAZKARY: ZAMEROSH!";
                new_line;
                style roman;

            }
        }
    }
    if (jumpsuit_timer > 0) {
        jumpsuit_timer = jumpsuit_timer - 1;
        if (jumpsuit_timer == 0) {
            deadflag = 1;
            print "^^The cold seeps into your bones. Without protection, your body succumbs to the frigid environment.^^";
        } else if (jumpsuit_timer == 1) {
            print "^Your body is starting to feel the extreme cold. You need protection soon.^^";
        }
    }
];
! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
[ GamePreRoutine;
    if (action ~= ##Freeze && action ~= ##Hide && action ~= ##Look && action ~= ##Wait) {
        if (player_hidden == 1) {
            player_hidden = 0;
            print "You move, breaking your concealment.^";
        }
    }
    if (action == ##Take && noun ~= nothing) {
        if (noun has static || noun has scenery) return false;
        if (GetCurrentBulk() + noun.bulk > MAX_CAPACITY) {
            print "You can't carry that. You're already encumbered.^";
            return true;
        }
    }
    return false;
];
! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
! Diagnostic Scan Routine
! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
[ PerformDiagnosticScan;
    if (HighTechJumpsuit in player || jumpsuit_worn == 1) {
        print "The diagnostic beam intensifies. Your internal sensors flare with activity. You feel a strange warmth spreading through your body, a sensation of... belonging.^";
        jumpsuit_worn = 1;
        PrintVisual("BIO-INTEGRATION COMPLETE. SUBJECT 009 IS NOW ARCHERON-9.");
        PrintAudio("ZRAAVEK: DOMN. CERNYV: STAVR.");
        print "^You look down at your hands. The fabric of the suit seems to ripple and flow, merging seamlessly with your skin. It's no longer something you wear; it's part of you. You feel its power, its purpose, coursing through your veins.^";
    } else {
        print "The scanner runs, but detects no anomalous bio-integration. Perhaps the suit is not present or not active.^";
    }
    return;
];
! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
[ TranslateAudio str_alien str_human;
    if (audio_codec_active) {
        print (string) str_human;
    } else {
        print (string) str_alien;
    }
    rtrue;
];
! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
[ TranslateVisual str_alien str_human;
    if (visual_cortex_active) {
        print (string) str_human;
    } else {
        print (string) str_alien;
    }
    rtrue;
];
! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
![ SwipeSub;
    ! Case 1: "swipe card" (noun is card, second is nothing)
 !   if (second == nothing) {
 !       if (noun == Keycard) "You swipe the card through the air idly. You'll need a reader for that.";
 !       "You'd need to swipe that through something, but it's not even a card. Are you OK?";
 !   }
    ! Case 2: "swipe card at [something that isn't a door]"
!    "Swiping the ~@<<noun~@>> at the ~@<<second~@>> does nothing.";
!];
[ SwipeSub;
    if (noun == 0) "Swipe what?";
    if (second == 0) {
        ! Check for a reader nearby
        if (EngineeringDoor in location) <<Swipe EngineeringDoor Keycard>>;
        "You swipe the card through the air, but nothing happens.";
    }
    ! Logic for swiping the card in the door/reader
    if (second == EngineeringDoor) {
        if (noun ~= Keycard) "The reader flashes red. Invalid card.";
        if (battery_count == 0) "The reader is dead.";
        <<Unlock EngineeringDoor Keycard>>;
    }
    "That doesn't have a card reader.";
];


