! ==============================================================================
! UTILITY ROUTINES
! ==============================================================================
[ Mod a b;
    if (b == 0) return 0;
    return a - (a / b) * b;
];

[ GetCurrentBulk i k;
    k = 0;
    objectloop(i in player) {
        if (i provides bulk) k = k + i.bulk;
        else k = k + BULK_NORMAL;
    }
    return k;
];

[ ChooseObjects obj code;
    ! If the parser is confused between multiple 'tubes'
    if (code == 2) { 
        ! If the player is trying to 'ENTER' or 'GO IN'
        if (action_to_be == ##Enter or ##Go) {
            if (obj == PlayerCryoTube) return 3; ! 3 = "Pick this one"
            if (obj == OccupiedTube or EmptyCryoTubes) return 2; ! 2 = "Don't pick this"
        }
    }
    return 0; ! Otherwise, let the parser ask "Which do you mean?"
];

! ==============================================================================
! HUD & AUDIO INTERFACE
! ==============================================================================

[ PrintVisual real_text;
    if (visual_cortex_active == 1) {
        print (string) real_text;
        return;
    }
    print "ZERAKTHYN: [STYRZOSH ZGRT]";
];

[ PrintAudio real_text;
    if (audio_codec_active == 1) {
        print (string) real_text;
        return;
    }
    print "~VZDYK... TSKOR... VESKRACH... NAADEN...~";
];

! ==============================================================================
! CUSTOM ACTIONS & ROUTINES
! ==============================================================================
[ InstallSub;
    if (noun == nothing) { print "Install what?"; rtrue; }
    if (noun notin player) { print "You don't have that."; rtrue; }
    if (action == ##Install) {
        if (noun.before(action)) return;
    }
    rtrue;
];

[ BlinkSub; "You blink, clearing the sweat from your eyes."; ];

[ BlinkTwiceSub;
    if (visual_cortex_active == 0) return false;
    if (last_qr_source == 0 || (last_qr_source notin location && last_qr_source ~= location)) {
        print "No active data streams detected.^";
        return true;
    }
    if (last_qr_source provides qr_content) {
        print (string) last_qr_source.qr_content;
        print "^";
        return true;
    }
    return false;
];

[ FreezeSub;
    player_hidden = 1;
    print "You freeze instantly. You slow your breathing and force your heart rate down, lowering your thermal signature.^";
    return true;
];

[ HideSub;
    player_hidden = 1;
    print "You dive behind cover, curling tight to minimize your silhouette. You hold your breath.^";
    return true;
];

[ RecallSub; "You can't recall that."; ];

! ==============================================================================
! DAEMONS & SYSTEMS
! ==============================================================================
[ ZerakthynAtmosphere r;
    ! 1. Do not run if the player is in the Brig
    if (location == Brig) return;

    ! 2. Only run the atmosphere logic if power has been restored
    if (power_restored == 1) { 
        if (random(10) == 1) {
            r = random(5);
            new_line;
            print "An intercom in the ceiling crackles to life!^";
            new_line;
            style underline;
            if (audio_codec_active == 1) {
                switch(r) {
                    1: print "~COOLANT LEAK DETECTED IN PRIMARY REACTOR CORE.";
                    2: print "~ATMOSPHERIC SCRUBBERS OFFLINE. CARBON TOXICITY RISING.";
                    3: print "~HULL INTEGRITY COMPROMISED. DECOMPRESSION IMMINENT.";
                    4: print "~GRAVITY WELL STABILIZERS AT ZERO PERCENT.";
                    5: print "~NEURAL BUFFER OVERFLOW. EMERGENCY SHUTDOWN FAILED.";
                }
            } else {
                switch(r) {
                    1: print "~KRZHDAR JADROZ... VZDYK... VZDYK.";
                    2: print "~POHYB STAVR... SCERNOSH ZRAAV.";
                    3: print "~SMRNK DRAZK... VESKRACH KRZHD.";
                    4: print "~JADROZ POHYB... VZDRAK TSKOR.";
                    5: print "~STYRZOSH KRZHD... DRAZKARY.";
                }
            }
            style roman;
            new_line;
        }
    }
];

[ DroneDaemon dir next_room;
    if (drone_active == 0 || power_restored == 0) return;

    ! --- 1. Interaction Logic (Is it in the same room?) ---
    if (parent(SecurityDrone) == location) {
if (drone_alert == 1) {
            print "^^THE DRONE FIRES!^A taser dart hits your neck. Your muscles seize up. The world goes black.^^^";
            style bold;
            print "     *** You have... NOT died ***^";
            style roman;

            ! 1. Wait for the player to acknowledge the "death"
            print "^[MORE]^";
            @read_char 1 -> next_room; 

            ! 2. Clear the screen for the "transition"
            @erase_window -1; 
            @set_cursor 1 1; ! Move cursor to the top-left of the fresh screen

            ! 3. Narrative transition and move
            print "But the way your head feels, you wish you had.^^You force your eyelids open against the glare of the blindingly white room.^";
            
            PlayerTo(Brig);
            drone_alert = 0;
            player_hidden = 0;
            return;
        }
        if (player_hidden == 0) {
            print "^^THE DRONE SPOTS YOU! Its red eye flares.^Your combat instincts scream: RUN!^";
            drone_alert = 1;
            return;
        } else {
            print "^The security drone hovers past, its sensors failing to pick you up.^";
        }
    }

! --- Algorithmic Movement (Light-Sensitive & Server-Averse) ---
    drone_alert = 0;
    dir = random(6); 
    
    switch(dir) {
        1: next_room = (parent(SecurityDrone)).n_to;
        2: next_room = (parent(SecurityDrone)).s_to;
        3: next_room = (parent(SecurityDrone)).e_to;
        4: next_room = (parent(SecurityDrone)).w_to;
        5: next_room = (parent(SecurityDrone)).u_to;
        6: next_room = (parent(SecurityDrone)).d_to;
    }

! Check: Valid object? Has light? Not the specific object? Not the class?
    if (metaclass(next_room) == Object && next_room ~= 0) {
        if (next_room has light && next_room ~= ServerFarm && ~~(next_room ofclass ServerFarm)) {
            move SecurityDrone to next_room;
        }
    }
    ! --- 3. Automatic Proximity Alert ---
    if (parent(SecurityDrone) == location) {
        print "^(WARNING: A Security Drone floats into the room!)^";
    } else {
        ! Check if the drone is in any room connected to the player's location
        if (parent(SecurityDrone) == location.n_to || parent(SecurityDrone) == location.s_to ||
            parent(SecurityDrone) == location.e_to || parent(SecurityDrone) == location.w_to) {
            print "^(PROXIMITY ALERT: You hear the low hum of an engine nearby.)^";
        }
    }
];
[ TimePasses;
    turn_count++;
    DroneDaemon();
    ZerakthynAtmosphere();
    if (power_restored == 0) {
        oxygen = oxygen - 1;
        if (oxygen == 15) print "^Your lungs burn. The air is getting thin...^";
        if (oxygen <= 0) {
            deadflag = 1;
            print "^^Black spots fill your vision. You gasp for air that isn't there. Collapse.^";
        }
        if (alarm_lights_active == 1) {
            if (Mod(turn_count, 2) == 0) {
                print "^Red alarm lights flash! A siren sounds! A voice booms!^";
                new_line;
                style underline;
                print "~KRZHDYN: STAVR! DRAZKARY: ZAMEROSH!";
                new_line;
                style roman;

            }
        }
    }
    if (jumpsuit_timer > 0) {
        jumpsuit_timer = jumpsuit_timer - 1;
        if (jumpsuit_timer == 0) {
            deadflag = 1;
            print "^^The cold seeps into your bones. Without protection, your body succumbs to the frigid environment.^";
        } else if (jumpsuit_timer == 1) {
            print "^Your body is starting to feel the extreme cold. You need protection soon.^";
        }
    }
];

[ GamePreRoutine;
    if (action ~= ##Freeze && action ~= ##Hide && action ~= ##Look && action ~= ##Wait) {
        if (player_hidden == 1) {
            player_hidden = 0;
            print "You move, breaking your concealment.^";
        }
    }
    if (action == ##Take && noun ~= nothing) {
        if (noun has static || noun has scenery) return false;
        if (GetCurrentBulk() + noun.bulk > MAX_CAPACITY) {
            print "You can't carry that. You're already encumbered.^";
            return true;
        }
    }
    return false;
];

! --- Diagnostic Scan Routine ---
[ PerformDiagnosticScan;
    if (HighTechJumpsuit in player || jumpsuit_worn == 1) {
        print "The diagnostic beam intensifies. Your internal sensors flare with activity. You feel a strange warmth spreading through your body, a sensation of... belonging.^";
        jumpsuit_worn = 1;
        PrintVisual("BIO-INTEGRATION COMPLETE. SUBJECT 009 IS NOW ARCHERON-9.");
        PrintAudio("ZRAAVEK: DOMN. CERNYV: STAVR.");
        print "^You look down at your hands. The fabric of the suit seems to ripple and flow, merging seamlessly with your skin. It's no longer something you wear; it's part of you. You feel its power, its purpose, coursing through your veins.^";
    } else {
        print "The scanner runs, but detects no anomalous bio-integration. Perhaps the suit is not present or not active.^";
    }
    return;
];

[ Translate str_alien str_human;
    if (visual_cortex_active) {
        print (string) str_human;
    } else {
        print (string) str_alien;
    }
    rtrue;
];

[ SwipeSub;
    ! Case 1: "swipe card" (noun is card, second is nothing)
    if (second == nothing) {
        if (noun == Keycard) "You swipe the card through the air idly. You'll need a reader for that.";
        "You'd need to swipe that through something, but it's not even a card. Are you OK?";
    }

    ! Case 2: "swipe card at [something that isn't a door]"
    "Swiping the ~@<<noun~@>> at the ~@<<second~@>> does nothing.";
];

[ Initialise;
    location = CryoBay;

    move Battery1 to CryoBay;
    move PlayerCryoTube to CryoBay;
    move EmptyCryoTubes to CryoBay;
    move OccupiedTube to CryoBay;
    move Battery2 to BatteryShelf;
    move Battery3 to BatteryShelf;
    move Battery4 to BatteryShelf;
    move HighTechJumpsuit to CryoBay;
    move Corpse to Corridor;
    move Keycard to Corpse;
    move OpticalModule to ServerRoom;
    move AudioModule to CommsRelay;

    move DiagnosticConsole to MedicalBay;
    move MedicalLogTerminal to MedicalBay;
    move OperatingTable to MedicalBay;
    move SecurityDrone to Atrium; 
    ! Start Drone
    StartDaemon(SecurityDrone);   
    ! --- Intro Sequence ---
    @erase_window $ffff;
    new_line;
    style underline;
    print "~Jadroz: veskrach... Domn: pohyb.~^";
    style roman;
    print "^You wake slowly, your breath misting in the chill air. The glass door of your cryo-tube slides open with a smooth hydraulic hiss. You step out onto the metal grating, shivering as the stasis fluid evaporates from your skin. From all around you, a voice barks:^";
    jumpsuit_timer = 3; ! Set the timer for 3 turns
    ! --- Place the HighTechJumpsuit in the CryoBay ---
    move HighTechJumpsuit to CryoBay;
    ! --- Activate Alarm Lights ---
    alarm_lights_active = 1;
    new_line;
    style underline;
    print "~KRZHDYN: STAVR! DRAZKARY: ZAMEROSH!~^";
    style roman;
    new_line;
    Banner();
    print "^Press any key to begin... ";
    @read_char 1 -> sp;
    @erase_window $ffff; ! Clear screen for game start
    ! --- Pre-Game Urgency Text ---
    print "^Red alarm lights begin flashing! You hear that voice again, and though you can't understand the strange words, you can feel their urgency.^";
    new_line;
    style underline;
    print "KRZHDYN: STAVR! DRAZKARY: ZAMEROSH!^";
    style roman;
    new_line;
    return 2; ! Suppress banner, start game
];

