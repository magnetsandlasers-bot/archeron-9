Object BridgeDoor "blast door"
  with name 'door' 'security',
       found_in Atrium Bridge,
       description "A reinforced door protecting the Bridge. It has a biometric scanner.",
       before [;
            Open, Unlock:
                if (location == Bridge) { give self ~locked open; "Unlocked."; }
                print "The scanner sweeps a laser over your retina. ";
                if (identity_hacked == 0) {
                    print "^VOICE: "; PrintAudio("ZRAAVEK TSKOR. VESKRACH DOMN NAADEN.");
                    print "^The door remains locked.^"; return true;
                }
                print "^VOICE: "; PrintAudio("VELMAR, CERNYV.");
                print "^The heavy bolts retract. The door opens.^";
                give self ~locked open; return true;
        ],
       after [;
            Go:
                give self ~open locked;
                "^The heavy door slides shut behind you with a pneumatic hiss.";
       ], door_dir n_to, door_to Bridge, has static door locked scenery;
Object BulkheadDoor "bulkhead"
  with  name 'bulkhead' 'massive' 'north' 'blast' 'south',
        found_in AftCorridor SpineFore,
        description [;
            print "A massive bulkhead separating the aft section from the main ship. ";
            if (power_restored == 0) "It is dark and unresponsive, its heavy bolts engaged.";
            if (lockdown_lifted == 0) {
                print "A hologram projected over the lock reads: ";
                PrintVisual("DRAZKARY ZAMEROSH");
                ". The lock remains engaged.";
            }
            if (bulkhead_passed == 0) "The lock has been released. The door stands open.";
            if (identity_hacked == 0) {
                print "The door has closed behind you. A hologram reads: ";
                PrintVisual("ACCESS DENIED: NON-COMMANDER PERSONNEL");
                ". It's sealed tight.";
            }
            "The commander override is active. The door can be opened.";
        ],
        before [;
            Open, Unlock:
                if (location == AftCorridor) {
                    if (power_restored == 0) "The electronic systems appear dead.";
                    if (lockdown_lifted == 0) "The lock is still engaged. You need to release it first.";
                    if (self has open) "The door is already open.";
                    give self ~locked open;
                    "The heavy door slides aside.";
                }
                ! Logic for the North side (SpineFore)
                print "The scanner sweeps a laser over your retina. ";
                if (identity_hacked == 0) {
                    TranslateAV("ZRAAVEK TSKOR. VESKRACH DOMN NAADEN.", "ACCESS DENIED: UNKNOWN BIOMETRICS.");
                    "^The door remains locked.";
                }
                TranslateAV("VELMAR, CERNYV.", "IDENTITY VERIFIED. WELCOME, COMMANDER.");
                give self ~locked open;
                "^The heavy bolts retract. The door grinds open.";
        ],
        after [;
            Go:
                ! Trigger the "Slam Shut" only when moving South to North for the first time
                if (location == SpineFore && bulkhead_passed == 0) {
                    bulkhead_passed = 1;
                    give self locked ~open;
                    "As you pass through, the massive bulkhead slams shut behind you with a heavy CLUNK! It seals tight.";
                }
        ],
        door_to [;
            if (location == AftCorridor) return SpineFore;
            return AftCorridor;
        ],
        door_dir [;
            if (location == AftCorridor) return n_to;
            return s_to;
        ],
  has   static door locked scenery;
Object EngineeringDoor "security door"
  with name 'door' 'security' 'heavy' 'engineering' 'east' 'west',
       description [;
            if (location == AftCorridor) {
                print "A heavy steel door with a card reader slot.";
                if (battery_count == 0) print " The lock's display is dead.";
                else { print " The display reads: "; PrintVisual("DRAZKOSH VZDYK"); }
            } else print "The inner face is smooth steel.";
            new_line; return true;
       ],
       found_in AftCorridor Engineering,
       door_dir [; if (location == AftCorridor) return e_to; return w_to; ],
       door_to [; if (location == AftCorridor) return Engineering; return AftCorridor; ],
       with_key Keycard,
       before [;
            Open:
                if (location == Engineering) "Use the green panel.";
                if (location == AftCorridor && self has locked) "The door is locked tight; you'll need a card.";
            Unlock:
                if (location == Engineering) "Use the green panel.";
                if (battery_count == 0) "The electronic lock appears dead.";
       ],
       after [;
            Unlock:
                give self ~locked; ! Ensure the lock state is toggled
                give self open;    ! Physically open the door
                "As you slide the card through, the lock chirps and the heavy door hums open.";
       ],
       has static door openable lockable locked scenery;
Object BrigDoor "reinforced door"
  with name 'door' 'brig' 'reinforced' 'security' 'north' 'south',
       description [;
            if (location == SecurityCheck) {
                print "A heavy, reinforced door with a glowing red panel and a keycard slot.";
                if (power_restored == 0) print " The panel is dark and unresponsive.";
                else { print " The panel reads: "; PrintVisual("DRAZKOSH ZAMEROSH"); }
            } else { 
                print "The inner face of the door is smooth, unyielding metal with no visible controls. There is a loudspeaker in the middle of door at eye level.";
            }
            new_line; return true;
       ],
       door_dir [; 
            if (location == SecurityCheck) return n_to; 
            return s_to; 
       ],
       door_to [;
            if (location == SecurityCheck) return Brig; ! Standard move into Brig
            
            ! --- ESCAPE LOGIC ---
            give self ~open;    ! Force shut
            give self locked;   ! Force locked
            new_line;
            style bold; print "CLANG!^"; style roman;
            print "The moment you clear the threshold, the reinforced door slams shut behind you. Magnetic bolts hiss as they cycle into place, sealing the Brig once more. You are free.^";
            PlayerTo(SecurityCheck);
            return true; ! Tells the engine "Move complete, stop here."
       ],
       before [;
            Open, Enter, Go:
                if (location == Brig) {
                    if (self has locked) {
                        "There's no way to open the door from in here. It's built to keep people in.";
                    }
                }
                if (location == SecurityCheck && power_restored == 0) {
                    "The electronic lock is dead.";
                }
       ],
       found_in SecurityCheck Brig,
       has static door openable lockable locked scenery;
Object LooseGrating "loose grating"
    with name 'grating' 'grate' 'loose' 'metal' 'gap' 'hole',
    is_found false,
    is_removed false,
    description [;
        if (self.is_removed) "The grating has been shoved aside, leaving a dark gap.";
        "It's a heavy metal grating. It looks like it might be loose.";
    ],
    found_in Brig CrampedSpace,
    door_to [;
        if (location == Brig) return CrampedSpace;
        return Brig;
    ],
    door_dir [;
        if (location == Brig) return d_to; ! Down from Brig
        return u_to;                ! Up from CrampedSpace
    ],
    before [;
        Examine, Search:
            if (self.is_found == false && location == Brig) "You don't see any such thing.";
        Take, Push, Pull, Remove:
            if (self.is_found == false && location == Brig) "You don't see any such thing.";
            if (self.is_removed) "It's already out of the way.";
            self.is_removed = true;
            "With a loud metallic scrape, you heave the grating aside.";
        Enter:
            if (self.is_found == false && location == Brig) "You don't see any such thing.";
            if (self.is_removed == false) "The grating is blocking the way.";
            ! The library handles the move automatically for Doors if we return false here
            ! or we can force it:
            print "You exhale deeply and squeeze through the tight gap...^";
            PlayerTo(self.door_to());
            rtrue;
    ],
    short_name [;
        if (self.is_found == false && location == Brig) rfalse;
        if (self.is_removed) { print "dark gap"; rtrue; }
        print "loose grating"; rtrue;
    ]
    has static door openable scenery; ! 'open' refers to the Door state, not our 'is_removed'
