! --- Room 1: The Entrance ---
ServerFarm ServerFarm1 "Server Farm"
    with zh_name "JADROZ PARYN",
        description "Towering black server racks. A doorway to the southeast leads to a landing.",
        se_to Landing,
        n_to ServerFarm2;

! --- The SW Corner ---
ServerFarm ServerFarm2 "Server Farm"
    with description "Towering black server racks.",
        n_to ServerFarm3,
        e_to ServerFarm7,
        s_to ServerFarm1;

! --- The Western Wall ---
ServerFarm ServerFarm3 "Server Farm"
    with description "Towering black server racks. You see a shelf here.",
        n_to ServerFarm4,
        e_to ServerFarm6,
        s_to ServerFarm2;

ServerFarm ServerFarm4 "Server Farm"
    with description "Towering black server racks.",
        w_to ServerFarm3,
        e_to ServerFarm5;

! --- The North Row ---
ServerFarm ServerFarm5 "Server Farm"
    with description "Towering black server racks.",
        w_to ServerFarm4,
        se_to ServerFarm8,
        s_to ServerFarm5; ! Back to itself

! --- The Central Hubs ---
ServerFarm ServerFarm6 "Server Farm"
    with description "Towering black server racks. You see a shelf here.",
        w_to ServerFarm3,
        sw_to ServerFarm7;

ServerFarm ServerFarm7 "Server Farm"
    with description "Towering black server racks.",
        n_to ServerFarm6,
        e_to ServerFarm10,
        w_to ServerFarm7; ! -- A loop back to itself to disorient --

! --- The Eastern Section ---
ServerFarm ServerFarm8 "Server Farm"
    with description "Towering black server racks.",
        w_to ServerFarm5,
        s_to ServerFarm9;

ServerFarm ServerFarm9 "Server Farm"
    with description "Towering black server racks.",
        n_to ServerFarm8,
        s_to ServerFarm9, ! Back to itself
        e_to ServerFarm12;

ServerFarm ServerFarm10 "Server Farm"
    with description "A dead-end corridor between the humming towers.",
        w_to ServerFarm7;

! --- The Final Stretch ---
ServerFarm ServerFarm11 "Server Farm"
    with description "Towering black server racks.",
        w_to ServerFarm11, ! Back to itself
        s_to ServerFarm12;

ServerFarm ServerFarm12 "Server Farm"
    with description "Towering black server racks. You see a shelf here.",
        n_to ServerFarm11,
        w_to ServerFarm9,
        se_to ServerTerminal;

! --- The Goal ---
ServerFarm ServerTerminalMachine "Server Terminal"
    with description "The chaotic hum of the farm fades, replaced by the steady glow of a master console.",
        n_to ServerFarm12,
        sw_to ServerFarm1;