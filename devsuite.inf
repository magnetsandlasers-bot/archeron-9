! ==============================================================================
! Developer Tools Suite - Final Stable Version
! ==============================================================================
[ VHelpSub;
    @erase_window -1;
    @set_cursor 1 1;
    style bold;
    print "MAINFRAME SYSTEM ADMINISTRATION - MANUAL PAGES (v4.0)^";
    style roman;
    print "------------------------------------------------------------^";
    
    style bold; print "NAME^"; style roman;
    print "    devsuite - ship systems debugging and drone management^^";

    style bold; print "SYNOPSIS^"; style roman;
    print "    vtog [flag]     - Toggles boolean state (1/0) of ship systems.^";
    print "    vjump [loc]     - Instant translocation to specified sector.^";
    print "    vsummon [id]    - Force drone battery depletion (d1, d2, all).^";
    print "    vwhere          - Real-time coordinate tracking for all units.^";
    print "    sysdev          - Launch Master Control dashboard.^";
    print "    vrestore        - Global system recovery and heal.^^";

    style bold; print "FLAGS (for vtog)^"; style roman;
    print "    power           - Main ship-wide power grid.^";
    print "    med             - Medical wing power and scanners.^";
    print "    lock            - Sector-wide security lockdown status.^";
    print "    vis             - Player's visual cortex/interface.^";
    print "    aud             - Audio codec/translation protocols.^";
    print "    bulk            - Bulkhead clearance/permission level.^";
    print "    id              - Identity masking/hacked status.^";
    print "    arpi            - ARPI awareness/active logic.^^";

    style bold; print "LOCATION CODES (for vjump)^"; style roman;
    print "    ws (workshop), bridge, spine, med, eng, cargo, cryo, brig^^";
    
    style bold; print "DRONE CODES (for vsummon)^"; style roman;
    print "    d1 (SecurityDrone1), d2 (SecurityDrone2), all^^";

    print "------------------------------------------------------------^";
    "Press any key to exit manual.";
    ];
[ DevMenuSub d i energy; ! <--- 'energy' must be declared here!
    @erase_window -1;
    @set_cursor 1 1;
    style bold;
    print "--- [ SHIP MASTER CONTROL ] ---^";
    style roman;

    print "Power:   [", power_restored, "] | Med Pwr: [", medical_wing_powered, "] | Lockdown: [", lockdown_lifted, "]^";
    print "Visual:  [", visual_cortex_active, "] | Audio:   [", audio_codec_active, "] | Identity: [", identity_hacked, "]^";
    print "Bulkhead:[", bulkhead_passed, "] | Arpi Aw:  [", arpi_aware, "] | Arpi Act: [", arpi_active, "]^";
    print "Oxygen:  [", oxygen, "] | Hidden:  [", player_hidden, "] | Jumpsuit: [", jumpsuit_worn, "]^";
    print "Batteries:[", battery_count, "] ^";

    new_line;
    style underline;
    print "Drone Tracking:^";
    style roman;
    
    i = 0;
    objectloop (d ofclass SecurityDrone) {
        i++;
        print "  ", i, ". ", (name) d, " (ID ", d.drone_id, ") -> ";
        
        ! --- Status & Pathing Logic ---
        if (DroneCharger.occupied_by == d) {
            print "CHARGING";
        } else if (d.move_count > 30) {
            print "GOING HOME (currently in ", (name) parent(d), ")";
        } else {
            print (name) parent(d);
        }

        ! --- Energy Math ---
    energy = 30 - d.move_count;
    if (energy < 0) energy = 0;
    print " [Energy: ", energy, "/30]^";
    }
    new_line;
    print "--- [ COMMANDS ] ---^";
    print "  VTOG [var] | VJUMP [loc] | VRESTORE | VWHERE | VBRIG^";
    "--------------------------------------------------";
    ];

! --- Toggle Logic ---
[ ToggleSub w;
    wn = consult_from;
    w = NextWord();
    switch(w) {
        'power', 'p': power_restored = 1 - power_restored;
        'med', 'm': medical_wing_powered = 1 - medical_wing_powered;
        'lock', 'l', 'lockdown': lockdown_lifted = 1 - lockdown_lifted;
        'vis', 'v', 'visual': visual_cortex_active = 1 - visual_cortex_active;
        'aud', 'a', 'audio': audio_codec_active = 1 - audio_codec_active;
        'bulk', 'b': bulkhead_passed = 1 - bulkhead_passed;
        'id': identity_hacked = 1 - identity_hacked;
        'arpi': arpi_aware = 1 - arpi_aware;
        default: "Toggle what? (p)ower, (m)ed, (l)ockdown, (v)isual, (a)udio, (b)ulkhead, (id), (arpi)";
    }
    print "System updated.^^";
    <<DevMenu>>;
    ];

! Defining 'vtog' as the primary toggle verb
! --- Warp Logic ---
[ WarpSub w;
    wn = consult_from;
    w = NextWord();
    switch (w) {
        'bridge': PlayerTo(Bridge);
        'spine': PlayerTo(SpineMid);
        'med', 'medbay': PlayerTo(MedicalBay);
        'eng', 'engineering': PlayerTo(Engineering);
        'cargo': PlayerTo(CargoBay);
        'home', 'cryo': PlayerTo(CryoBay);
        'workshop', 'ws': PlayerTo(DroneWorkshop); ! <--- NEW JUMP POINT
        'drone', 'd1':
            if (SecurityDrone1 ~= 0) PlayerTo(parent(SecurityDrone1));
            else "SecurityDrone1 not defined.";
        'd2':
            if (SecurityDrone2 ~= 0) PlayerTo(parent(SecurityDrone2));
            else "SecurityDrone2 not defined.";
        'brig': PlayerTo(Brig);
        'terminal': PlayerTo(ServerTerminal);
        default: "Teleport failed. Use: bridge, spine, med, eng, workshop, d1, d2, brig";
    }
    ];

[ SummonSub w d;
    wn = consult_from;
    w = NextWord();
    
    switch(w) {
        'd1': 
            d = SecurityDrone1;
        'd2': 
            d = SecurityDrone2;
        'all':
            objectloop (d ofclass SecurityDrone) {
                d.move_count = 31;
            }
            "All drones depleted. Summoning sequence initiated.^";
        default: 
            "Usage: vsummon d1, vsummon d2, or vsummon all";
    }

    if (d == 0) "Error: Target drone not found.";

    d.move_count = 31; ! Forces the 'Battery Check' logic to trigger
    print (name) d, " (ID ", d.drone_id, ") battery depleted. Summoning...^";
    rtrue;
    ];

! --- Tracking & Utils ---
[ WhereSub d;
    print "^--- [ CURRENT DRONE POSITIONS ] ---^";
    objectloop (d ofclass SecurityDrone) {
        print (name) d, " (ID ", d.drone_id, "): ", (name) parent(d), "^";
    }
    "------------------------------------";
    ];

[ DevBrigSub; 
    CapturePlayer(); 
    ];

[ HealSub;
    power_restored = 1;
    lockdown_lifted = 1;
    arpi_aware = 1;
    "All systems stabilized.";
    ];



