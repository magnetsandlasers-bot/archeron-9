! ==============================================================================
! Developer Tools Suite - Final Stable Version
! ==============================================================================

[ DevMenuSub d i;
    @erase_window -1;
    @set_cursor 1 1;
    style bold;
    print "--- [ SHIP MASTER CONTROL ] ---^";
    style roman;

    print "Power:   [", power_restored, "] | Med Pwr: [", medical_wing_powered, "] | Lockdown: [", lockdown_lifted, "]^";
    print "Visual:  [", visual_cortex_active, "] | Audio:   [", audio_codec_active, "] | Identity: [", identity_hacked, "]^";
    print "Bulkhead:[", bulkhead_passed, "] | Arpi Aw:  [", arpi_aware, "] | Arpi Act: [", arpi_active, "]^";
    print "Oxygen:  [", oxygen, "] | Hidden:  [", player_hidden, "] | Jumpsuit: [", jumpsuit_worn, "]^";
    print "Batteries:[", battery_count, "] ^";

    new_line;
    style underline;
    print "Drone Tracking:^";
    style roman;
    i = 0;
    objectloop (d ofclass SecurityDrone) {
        i++;
        print "  ", i, ". ", (name) d, " (ID ", d.drone_id, ") -> ", (name) parent(d);
        print " [Energy: ", 10 - d.move_count, "/10]^";
    }

    new_line;
    print "--- [ COMMANDS ] ---^";
    print "  VTOG [var] | VJUMP [loc] | VRESTORE | VWHERE | VBRIG^";
    "--------------------------------------------------";
];

! System Level Verbs - Prefixed with 'V' to avoid ANY dictionary collisions
Verb 'sysdev' 'diagnose' * -> DevMenu;
Verb 'vwhere' * -> Where;
Verb 'vbrig' * -> DevBrig;

! --- Toggle Logic ---
[ ToggleSub w;
    wn = consult_from;
    w = NextWord();
    switch(w) {
        'power', 'p': power_restored = 1 - power_restored;
        'med', 'm': medical_wing_powered = 1 - medical_wing_powered;
        'lock', 'l', 'lockdown': lockdown_lifted = 1 - lockdown_lifted;
        'vis', 'v', 'visual': visual_cortex_active = 1 - visual_cortex_active;
        'aud', 'a', 'audio': audio_codec_active = 1 - audio_codec_active;
        'bulk', 'b': bulkhead_passed = 1 - bulkhead_passed;
        'id': identity_hacked = 1 - identity_hacked;
        'arpi': arpi_aware = 1 - arpi_aware;
        default: "Toggle what? (p)ower, (m)ed, (l)ockdown, (v)isual, (a)udio, (b)ulkhead, (id), (arpi)";
    }
    print "System updated.^^";
    <<DevMenu>>;
];

! Defining 'vtog' as the primary toggle verb
Verb 'vtog' 'vtoggle' 'devpower' * topic -> Toggle;

! --- Warp Logic ---
[ WarpSub w;
    wn = consult_from;
    w = NextWord();
    switch (w) {
        'bridge': PlayerTo(Bridge);
        'spine': PlayerTo(SpineMid);
        'med', 'medbay': PlayerTo(MedicalBay);
        'eng', 'engineering': PlayerTo(Engineering);
        'cargo': PlayerTo(CargoBay);
        'home', 'cryo': PlayerTo(CryoBay);
        'drone', 'd1':
            if (SecurityDrone1 ~= 0) PlayerTo(parent(SecurityDrone1));
            else "SecurityDrone1 not defined.";
        'd2':
            if (SecurityDrone2 ~= 0) PlayerTo(parent(SecurityDrone2));
            else "SecurityDrone2 not defined.";
        'brig': PlayerTo(Brig);
        'terminal': PlayerTo(ServerTerminal);
        default: "Teleport failed. Use: bridge, spine, med, eng, cargo, home, d1, d2, brig";
    }
    !<<Look>>;
];

Verb 'vjump' 'vwarp' 'vgoto' * topic -> Warp;

! --- Tracking & Utils ---
[ WhereSub d;
    print "^--- [ CURRENT DRONE POSITIONS ] ---^";
    objectloop (d ofclass SecurityDrone) {
        print (name) d, " (ID ", d.drone_id, "): ", (name) parent(d), "^";
    }
    "------------------------------------";
];

[ DevBrigSub; 
    CapturePlayer(); 
];

[ HealSub;
    power_restored = 1;
    lockdown_lifted = 1;
    arpi_aware = 1;
    "All systems stabilized.";
];

Verb 'vrestore' 'vheal' * -> Heal;