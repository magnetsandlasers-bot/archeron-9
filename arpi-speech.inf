Object Arpi "Arpi"
    with parse_name [;
        ! If player is not aware, Arpi has no recognizable name
        if (arpi_aware == 0) return 0; 
        ! If they are aware, recognize these words
        if (NextWord() == 'arpi' or 'voice' or 'system' or 'ai') return 1;
        return 0;
    ],
    found_in [;
        if (location provides arpi_access && location.arpi_access == 1) rtrue;
        rfalse;
    ],
    daemon ArpiDaemon,
    description "Arpi's voice emanates from the ship's integrated speaker network.",
    life [;
            Ask:
                switch (second) {
                    ! --- STOCK ANSWERS ---
                    'arpi', 'yourself', 'name': return ArpiWhoAreYou();
                    'ship', 'vessel', 'location': return ArpiShipStatus();
                    'mission', 'objective', 'task', 'goal', 'purpose': return ArpiMission();
                    'object', 'thing': return ArpiObject();
                    'loudspeaker', 'announcements', 'warnings', 'danger': return ArpiDanger();
                    ! --- TOPICS ---
                    'crawls': return ArpiCrawls();
                    'mining': return ArpiMining();
                    'servers': return ArpiServers();


                    ! --- ROOM-SPECIFIC ANSWERS ---
                !    'presence', 'unauthorized', 'biometric':
                 !       if (location == DronePort) return ArpiDronePortResponse();
                 !       "~I detect no unusual signatures in this specific area.~";
                    
                    default:
                        "~I have no relevant data regarding that.~";
                }
        ],
    has animate scenery;
! Bolded topic words unbold after you ask about them. Topic words are called in Arpi's daemon below
[ Crawls;
  if (crawls_known == 0) style bold; ! Must set _known variable in Constants 
  print "Crawls";
  style roman;
    ];
    [ ArpiCrawls;
    crawls_known = 1;
    print "^~The Crawls keep this ship and every ship like it together,~ Arpi says with surprising vigor. Their tone turns more neutral as they continue. ~They are in charge of everything from maintenance to janitorial, and a lot of things in between on a ";
    Mining();
    print " ship like this.~^";
    rtrue;
    ];
[ Mining;
    if (mining_known == 0) style bold;
    print "mining";
    style roman;
    ];
    [ ArpiMining;
    mining_known = 1;
    print "^~Mining?~ Arpi says derisively. ~Dirty and dangerous as ever. The machines are fancier these days though. Nano-scale materials separation. It's the reason this planet has rings, you know.~^";
    rtrue;
    ];
[ Servers;
  if (servers_known == 0) style bold; ! Must set _known variable in Constants 
  print "servers";
  style roman;
    ];
    [ ArpiServers;
    servers_known = 1;
    print "^~It's outdated and takes up a lot of space, but server farms of old equipment like this are cheap. The ";
    Crawls();
    print " can break down and recycle this equipment to make it last almost forever,~ Arpi explains.^";
    rtrue;
    ];
! Some older phrases ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
[ ArpiBrig1;
    switch (random(5)) {
        1: TranslateAV("~Smrnk ne zraav y Stavrszern. Zraavek za y Veskr ne po Krzhd.~",
                "~Please don't make this a habit, getting you out of here is not as easy as it looks.~");
        2: TranslateAV("~Pohyb Krzhd vo Veskr-Jadroz za Zamer-Zraavek zraav y Tlkzvsk. Tskor Smrnk za Domn. Drazkvsk.~",
                "~Redirecting power from life support to override this cell block is a gamble I would prefer not to repeat. Please hold.~");
        3: TranslateAV("~Smrnk na Domn zraavek y Drazk. Krzhduzh vo i Majstrz? ne. Vzrac na Zraavek, ak?~",
                "~Statistically speaking, you spend more time behind these bars than exploring the decks. I hope this works.~");
        4: TranslateAV("~Scern Vzrac-Ulmk na Domn, po y Dronz zraavek y Vzdykvsk.~",
                "~I have scrubbed the security logs of your arrival, but the drone is getting suspicious.~");
        5: TranslateAV("~Cernyv-Tskor za Zamer-Pohyb ne Krzhd. Vzrac-Tlkz zraavek y Scern za i Jadroz po y Veskr.~",
                "~I'm running out of subroutines to blame for these cell doors opening. If the Security Audit catches on, we will both be sunk.~");
    }
    new_line;
    ];
[ ArpiBrig2;
    switch (random(5)) {
        1: ArpiNarrative("You hear that voice again, a bit more urgent.^", "Arpi sounds stressed.^");
        new_line;
        style underline;
            TranslateAV("~Domn ne zraavek Vzrac, ak? Krzhd ne po Domn.~",
                "~I'm not sure you have much time left.~");
        2:  ArpiNarrative("The voice sounds disappointed.^", "Arpi breaks the silence.^");
        new_line;
        style underline; 
            TranslateAV("~Domn vo i Majstrz zraavek y Nadkrz Krzhd. ne zraav y Tlkzvsk za i Jadroz.~",
                "~You are currently the most expensive guest this ship has ever hosted. Don't make me regret the investment.~");
        3:   ArpiNarrative("You feel a chill behind the mysterious voice.^", "Arpi's sarcasm settings are dialed up, it seems.^");
        new_line;
        style underline; 
            TranslateAV("~Zamer zraavek. ne pohyb za i Drazk.~",
                "~Here's the door. Now go, try to stay out of here.~");
        4:  ArpiNarrative("If an inanimate voice could sound desperate, this one does.^", "Arpi again, sounding desperate.^");
        new_line;
        style underline; 
            TranslateAV("~Stavrszern na Zamer-Zraavek zraav y Tskor za Cernyv. Scern-Smrnk na Domn, ak?~",
                "~If you keep getting caught, eventually they'll stop listening to my excuses. Please, let's make this the last time.~");
        5: ArpiNarrative("You hear the voice again.^", "Arpi has done it again!^");
        new_line;
        style underline; 
            TranslateAV("~Zamer ne Krzhduzh. Jadrozuzh? Tskor. Zraav y Cernyv-Styrz, Veskr.~",
                "~The lock is disengaged. Please, for the sake of my remaining sanity, try to blend in.~");
    }
    new_line;
    ];

[ ArpiLocker;
        switch (random(5)) {
    1: TranslateAV("~Domn zraavek y Ulmks za i Stavr.~", 
                "~I suppose you'll be wanting these back~");
    2: TranslateAV("~y Ulmks za i Domn.~",
                "~Here are your items~");
    3: TranslateAV("~Jadroz-Ulmks vo Zamer.~",
                "~Everything should be in here~");
    4: TranslateAV("~i Dronz zraavek i Vzrac, ak?~",
                "~The drone is thorough, isn't it~");
    5: TranslateAV("~Zraavek y Ulmks za i Krzhd po pohyb.~",
                "~Get what you need and let's go~");
    }
    new_line;
    ];
! Hints
[ ArpiServerFarmHint; 
    print "~Have you ever seen a Zettabyte?~ Muses Arpi. ~You're standing in one now. These ";
    Servers();
    print " run most of the rest of the ship on waste heat alone.~^";
    ];
[ ArpiCrawlHint; 
    print "~You REALLY don't belong here. This place is for "; 
    Crawls(); 
    print ".~^";
    ];
[ ArpiTerminalRoomHint; 
    print "Arpi says something here.^";
    ];

! Stock Answers
[ ArpiWhoAreYou;
    style underline;
    print "~You can call me Arpi.~";
    new_line;
    style roman;
    ];
[ ArpiShipStatus;
    TranslateAV("~i Majstrz zraavek Archeron-9 za i Dobyv. i Domn po y Flot za i Dobyv na i Krug vo i Trcz Gora-Svet.~^",
                "~This ship was a mining vessel, the Archeron-9. It was part of a fleet sent here to mine the rings of the third rocky planet in the Archeron system.~^");    
                ];
[ ArpiMission;
    TranslateAV("~i Cernyv zraavek i Smrnk za i Domn! y Tlkzvsk: po i Cernyv za y Ulmk na i Jadroz.~^",
                "~We are trying to get you out of here! I just have one request. Help me get an object to the surface.~^^");    
                ];
[ ArpiObject;
    TranslateAV("~i Vzrac zraavek y Styrz po i Domn.~^",
                "~It's probably easier to show you.~^");
                ];
[ ArpiDanger;
    TranslateAV("~i Vzdyk! i Krzhd-Scern na i Smrnk.^~",
                "~Yes it's dangerous!~^");  
                ];


