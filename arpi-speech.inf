[ ArpiBrig1;
    switch (random(5)) {
        1: Translate("~Smrnk ne zraav y Stavrszern. Zraavek za y Veskr ne po Krzhd.~",
                "~Please don't make this a habit, getting you out of here is not as easy as it looks.~");
        2: Translate("~Pohyb Krzhd vo Veskr-Jadroz za Zamer-Zraavek zraav y Tlkzvsk. Tskor Smrnk za Domn. Drazkvsk.~",
                "~Redirecting power from life support to override this cell block is a gamble I would prefer not to repeat. Please hold.~");
        3: Translate("~Smrnk na Domn zraavek y Drazk. Krzhduzh vo i Majstrz? ne. Vzrac na Zraavek, ak?~",
                "~Statistically speaking, you spend more time behind these bars than exploring the decks. I hope this works.~");
        4: Translate("~Scern Vzrac-Ulmk na Domn, po y Dronz zraavek y Vzdykvsk.~",
                "~I have scrubbed the security logs of your arrival, but the drone is getting suspicious.~");
        5: Translate("~Cernyv-Tskor za Zamer-Pohyb ne Krzhd. Vzrac-Tlkz zraavek y Scern za i Jadroz po y Veskr.~",
                "~I'm running out of subroutines to blame for these cell doors opening. If the Security Audit catches on, we will both be sunk.~");
    }
    new_line;
];

[ ArpiBrig2;
    switch (random(5)) {
        1: ArpiNarrative("You hear that voice again, a bit more urgent.^", "Arpi sounds stressed.^");
        new_line;
        style underline;
            Translate("~Domn ne zraavek Vzrac, ak? Krzhd ne po Domn.~",
                "~I'm not sure you have much time left.~");
        2:  ArpiNarrative("The voice sounds disappointed.^", "Arpi breaks the silence.^");
        new_line;
        style underline; 
            Translate("~Domn vo i Majstrz zraavek y Nadkrz Krzhd. ne zraav y Tlkzvsk za i Jadroz.~",
                "~You are currently the most expensive guest this ship has ever hosted. Don't make me regret the investment.~");
        3:   ArpiNarrative("You feel a chill behind the mysterious voice.^", "Arpi's sarcasm settings are dialed up, it seems.^");
        new_line;
        style underline; 
            Translate("~Zamer zraavek. ne pohyb za i Drazk.~",
                "~Here's the door. Now go, try to stay out of here.~");
        4:  ArpiNarrative("If an inanimate voice could sound desperate, this one does.^", "Arpi again, sounding desperate.^");
        new_line;
        style underline; 
            Translate("~Stavrszern na Zamer-Zraavek zraav y Tskor za Cernyv. Scern-Smrnk na Domn, ak?~",
                "~If you keep getting caught, eventually they'll stop listening to my excuses. Please, let's make this the last time.~");
        5: ArpiNarrative("You hear the voice again.^", "Arpi has done it again!^");
        new_line;
        style underline; 
            Translate("~Zamer ne Krzhduzh. Jadrozuzh? Tskor. Zraav y Cernyv-Styrz, Veskr.~",
                "~The lock is disengaged. Please, for the sake of my remaining sanity, try to blend in.~");
    }
    new_line;
];

[ ArpiLocker;
    switch (random(5)) {
1: Translate("~Domn zraavek y Ulmks za i Stavr.~", 
                "~I suppose you'll be wanting these back~");
2: Translate("~y Ulmks za i Domn.~",
                "~Here are your items~");
3: Translate("~Jadroz-Ulmks vo Zamer.~",
                "~Everything should be in here~");
4: Translate("~i Dronz zraavek i Vzrac, ak?~",
                "~The drone is thorough, isn't it~");
5: Translate("~Zraavek y Ulmks za i Krzhd po pohyb.~",
                "~Get what you need and let's go~");
    }
    new_line;
];

