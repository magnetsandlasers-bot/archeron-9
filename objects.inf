Object DroneSocket "wall socket" DroneWorkshop
  with name 'mechanism' 'slot' 'recess' 'dock' 'wall' 'port' 'hole',
       description "A recessed port set into the wall. It features a deep, cylindrical cavity with heavily scarred contact points on the bottom.",
       before [;
            Receive:
                if (child(self) ~= 0) "The slot is occupied.";
                
                ! 1. First, check if the object even HAS a 'charged' property
                if (noun provides charged) {
                    
                    ! 2. Now it is safe to check the value of 'charged'
                    if (noun.charged == 1) {
                        move noun to self;
                        "You slide the pulsing cylinder in, but it's already fully charged.";
                    }

                    if (noun.charged == 0) {
                        if (noun == Battery1) { remove Battery1; move ChargedCell1 to self; }
                        if (noun == Battery2) { remove Battery2; move ChargedCell2 to self; }
                        if (noun == Battery3) { remove Battery3; move ChargedCell3 to self; }
                        if (noun == Battery4) { remove Battery4; move ChargedCell4 to self; }
                        if (noun == Battery5) { remove Battery5; move ChargedCell5 to self; }
                        if (noun == Battery6) { remove Battery6; move ChargedCell6 to self; }
                        "You slide the cylinder into the wall port. It locks with a clunk. 
                        A high-pitched whine builds up, and the unit begins to glow.";
                    }
                }

                ! 3. If it doesn't provide 'charged', it's not a battery.
                "That doesn't fit.";
       ],
    has static container open scenery;
Object DroneCharger "drone charger" DroneWorkshop
  with name 'charger' 'machine' 'generator' 'housing' 'slot' 'cavity' 'hole' 'wall' 'unit',
       occupied_by 0,
       description [;
           print "A wall unit for recharging drones.";
           if (child(self) ~= 0) {
               print " ", (The) child(self), " is seated in the charging slot.";
           } else {
               print " The charging slot is empty.";
           }
           new_line;
           rtrue;
       ],
       describe [; rtrue; ],
       before [ d; 
            Receive:
                if (noun == SecurityDrone1 or SecurityDrone2 or BrokenDrone) {
                    "The drone is broken beyond your ability to repair, and it does not even register in the charger.";
                }
                if (noun provides charged) {
                    if (noun.charged == 0) "That battery is dead.";
                } else {
                    "That doesn't fit the charging port.";
                }
            LetGo: 
                if (noun provides charged) {
                    d = self.occupied_by; 

                    if (d == SecurityDrone1 or SecurityDrone2) {
                        ! Only award points if the drone is currently alive
                        if (d.is_active == 1) {
                            d.is_active = 0; 
                            give d ~static;
                            
                            ! --- SCORING LOGIC ---
                            if (d == SecurityDrone1) achieved(7);
                            if (d == SecurityDrone2) achieved(8);
                        }
                        
                        self.occupied_by = 0; 
                        
                        print "As you attempt to yank ", (the) noun, " out, the unit sparks violently! 
                        The drone's red eye flickers and goes dark. A wisp of smoke rises gently from the inert sphere.^^";
                        rtrue; 
                    }
                }
       ],
  has container open;
Object CargoCrates "crates" CargoBay
    with name 'crate' 'crates', 
    description "Standard shipping crates.", 
    has static scenery;
Object DataWafer "data wafer"
    with name 'wafer' 'disk' 'chip' 'admin',
    description "A small data chip.",
    bulk BULK_POCKET;

Object DroneHatch "drone hatch"
    with name 'hatch' 'ceiling' 'opening' 'vent' 'shutter' 'iris',
         description "A small, circular iris-shutter recessed into the ceiling panels. It's designed for automated units; there are no manual controls, and the gap is far too narrow for a human to squeeze through.",
         found_in [;
             if (location has light) rtrue; ! Exists in every lit room
             rfalse;
         ],
         before [;
             Enter, Go, Climb:
                 "The hatch is high above you and sealed by a biometric lock. It's strictly for the drones.";
             Open:
                 "You can't find any interface to open it. It only responds to drone proximity signals.";
             Take, Pull, Remove:
                 "It's built into the very frame of the ship's hull.";
         ],
    has  scenery static;
Object EquipmentShelf "equipment shelf" ServerFarm3
  with name 'shelf' 'shelves' 'rack' 'metal',
       description [;
           print "A metal shelf bolted to a server. Perusing its jumbled contents, ";
           
           if (child(self) == 0) "you notice nothing of value.";
           
           print "you see ";
           WriteListFrom(child(self), ENGLISH_BIT + TERSE_BIT);
           ".";
       ],
       before [;
           Receive:
                if (noun.shelvable ~= 1) {
                    print "That doesn't look like it belongs on the shelf.^";
                    return true;
                }
                move noun to self;
                "You nestle ", (the) noun, " among the other items on the shelf.";
       ],
  has static supporter scenery;

Object RetinalScanner "retinal scanner"
    with name 'glasses' 'reader' 'scanner' 'retinal',
    description "A set of retinal scanning glasses",
    shelvable 1,
    bulk BULK_POCKET;







