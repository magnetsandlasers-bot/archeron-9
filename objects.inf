! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Object CotUnmade "unmade cot"
    with name 'bed' 'cot' 'bunk' 'sheets' 'blanket',
    description "Dingy would be a kind way to describe the filthy nest you woke up in."
    has static scenery;
! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Object EvidenceLocker "evidence locker" SecurityCheck
  with name 'locker' 'evidence' 'cabinet' 'drawer',
       description [;
           print "A kind of secure storage unit. It has a serious-looking electronic lock. ";
           if (self has open) {
               if (child(self) == nothing) "It is currently empty.";
               "Inside, you see your confiscated belongings.";
           }
           "It is currently sealed tight.";
       ],
       when_closed [;
           print "A reinforced locker is set into the wall under a sign reading ";
           TranslateVisual("KOVRAZHSK." , "EVIDENCE.");
       ],
       when_open "The locker stands open, its contents long since ransacked.",
       before [;
           Open:
               if (self has locked) {
                   if (arpi_active == 1) {
                       give self ~locked;
                       print "As you reach for the locker, the electronic bolt slides back with a sharp click. ";
                       ArpiNarrative("The intercom voice speaks up:^", "Arpi sighs:^");
                       style underline;
                       ArpiLocker();
                       style roman;
                       new_line;
                       ! We let the action continue so it actually opens.
                   } else {
                       "The locker is firmly sealed. You'll need some way to override the electronic lock.";
                   }
               }
       ],
       daemon [;
           ! Reset logic: if it's empty and shouldn't be accessible, relock it.
           if (child(self) == nothing && self hasnt open) {
               give self locked;
           }
       ],
  has static container open locked; 
  ! This assumes Global arpi_active is defined in your other file.

Object Arpi "Arpi's voice"
    with name 'arpi' 'voice' 'ai' 'system',
    arpi_state 0,

    React_Before [;
        ! We use 'Answer' because that's the internal 
        ! action name for 'saying' something.
        Answer, Ask, Tell:
            if (arpi_active == 1) {
                if (noun == 0 || noun == player) <<Answer self>>;
            }
    ],

    Life [;
        ! 'Answer' handles "SAY HELLO", "HI", or "ARPI, [WHATEVER]"
        Answer:
            return self.greet_routine();
        
        Ask:
            switch (second) {
                'mission', 'orders': "Arpi clarifies, 'Our objective is retrieval.'";
                'status': "Arpi chirps, 'All systems nominal.'";
                default: "The voice pauses. 'Data on that topic is restricted.'";
            }
    ],

    greet_routine [;
        switch (self.arpi_state) {
            0: 
                self.arpi_state = 1;
                "The speakers crackle. 'Hello, Operator. I am Arpi. Systems are online.'";
            1: 
                "Arpi's voice is calm. 'Yes? I am still here, Operator.'";
            default: 
                "Arpi sounds slightly impatient. 'We really should be moving.'";
        }
    ],
    has animate scenery;

Object DroneBench "drone workbench"
    with name 'workbench' 'table' 'bench',
       description [;
           print "A shiny, sterile-looking workbench. A pegboard with some tools is at hand. ";
           
           if (child(self) == 0) "Otherwise, the workbench is empty.";
           
           print "On the workbench, you see ";
           WriteListFrom(child(self), ENGLISH_BIT + TERSE_BIT);
           ".";
       ],
       before [;
           Receive:
                if (noun.shelvable ~= 1) {
                    print "That doesn't look like it belongs on the metal shelf.^";
                    return true;
                }
                move noun to self;
                "You put ", (the) noun, " on the workbench.";
       ],
  has static supporter scenery;
