! Objects
! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Object PlayerCryoTube "empty tube you came out of"
 with parse_name [;
           if (wn > 0 && (NextWord() == 'mine' or 'empty' or 'tube' or 'pod')) return 3;
           return 0;
       ],
       description [;
           print "This is the tube you woke up in. The curved door has recessed into its pocket and steam is wafting from its still-warm interior. Tubes and wires, many of which were only recently attached to you in ways you'd rather not think about again, hang limp and useless. The bio-monitor display reads: ";
           Translate("DOMN 009 KRZSHDOSH- NESTAV", "SUBJECT 009 STATUS- DEFECTIVE");
           new_line;
           if (self hasnt open) "The heavy glass lid is now permanently sealed.";
           return true;
       ],
       door_to TubeInterior,
       door_dir in_to,
       before [;
           Enter:
               if (self hasnt open) "It's sealed shut.";
               PlayerTo(TubeInterior); rtrue;
           Close:
               if (self has open) {
                   give self ~open;
                   "You pull the glass lid shut. With a hiss of hydraulics and a final, heavy 'clunk,' the seals lock permanently. You won't be getting back in there.";
               }
           Open:
               if (self hasnt open) "The locking mechanism has engaged fully; it's sealed for good.";
       ],
       has static scenery door open enterable;
Object EmptyCryoTubes "bank of cryo tubes"
     with name 'bank' 'row' 'tubes' 'pods' 'open' 'empty' 'vacant',
          description "A row of closed upright tubes with frosted glass fronts. Most are vacant, but one near you appears occupied.",
          before [;
              Open:
                  "The heavy seals are fused shut; no amount of prying will budge them.";
              Close:
                  "They are already sealed tight.";
          ],
          has static scenery;

Object OccupiedTube "occupied cryo tube"
     with name 'occupied' 'tube' 'pod' 'closed' 'glass' 'sealed',
          description [;
              print "You see the deathly-still silhouette of a misshapen figure slumped in the sealed tube. The bio-monitor display reads: ";
              Translate("DOMN 012 KRZSHDOSH- NESTAV. ", "SUBJECT 012 STATUS- DEFECTIVE. ");
              new_line;
              rtrue;
          ],
          before [;
              Open:
                  "The heavy seals are fused shut; no amount of prying will budge them. Probably for the best. It doesn't look good.";
              Close:
                  "It is already sealed tight.";
          ],
          has static scenery container ~open;
Object HighTechJumpsuit "high-tech jumpsuit"
  with name 'jumpsuit' 'suit' 'grey' 'tech', 
       bulk BULK_NORMAL,
       description "A sleek, form-fitting jumpsuit made of a dark grey, advanced material. It feels surprisingly light yet durable.",
       before [;
            Take, Wear: 
                if (self in player) { "You are already wearing the jumpsuit."; }
                move self to player;
                give self worn;
                give self concealed; ! This hides it from the inventory list
                jumpsuit_worn = 1;
                jumpsuit_timer = 0;
                "You slip on the jumpsuit. It conforms to your body like a second skin. The advanced nano-material adjusts to your temperature. You feel secure, protected, and... inseparable from the fabric.";
            Remove, Drop:
                "This suit is not coming off, no matter how hard you try. It's like a second skin, and your fingers can't get a purchase on the fabric.";
       ],
    has clothing;
Object Battery1 "heavy cylinder" ! In CryoBay
     with initial "A heavy, dark cylinder lies on the floor.",
     name 'cell' 'battery' 'cylinder' 'heavy',
     short_name "heavy cylinder",
     plural "heavy cylinders",
     list_together "heavy cylinders",
     description "A heavy, dark cylinder. A recessed groove runs around its middle.",
     bulk BULK_HEAVY;

Object Battery2 "heavy cylinder" ! On metal shelf
     with name 'heavy' 'cylinder' 'cylinders' 'battery' 'batteries' 'cell' 'unit',
     short_name "heavy cylinder",
     plural "heavy cylinders",
     description "A heavy, dark cylinder. A recessed groove runs around its middle.",
     bulk BULK_HEAVY;

Object Battery3 "heavy cylinder" ! On metal shelf
     with name 'heavy' 'cylinder' 'cylinders' 'battery' 'batteries' 'cell' 'unit',
     short_name "heavy cylinder",
     plural "heavy cylinders",
     description "A heavy, dark cylinder. A recessed groove runs around its middle.",
     bulk BULK_HEAVY;

Object Battery4 "heavy cylinder" ! On metal shelf
     with name 'heavy' 'cylinder' 'cylinders' 'battery' 'batteries' 'cell' 'unit',
     short_name "heavy cylinder",
     plural "heavy cylinders",
     description "A heavy, dark cylinder. A recessed groove runs around its middle.",
     bulk BULK_HEAVY;

Object ChargedCell1 "pulsing cylinder"
  with name 'cylinder' 'canister' 'heavy' 'unit' 'battery' 'pulsing' 'cell',
       bulk BULK_HEAVY,
       description "The cylinder has come to life. Blue light pulses from the recessed groove, and the casing feels warm.";

Object ChargedCell2 "pulsing cylinder"
  with name 'cylinder' 'canister' 'heavy' 'unit' 'battery' 'pulsing' 'cell',
       bulk BULK_HEAVY,
       description "The cylinder has come to life. Blue light pulses from the recessed groove, and the casing feels warm.";

Object ChargedCell3 "pulsing cylinder"
  with name 'cylinder' 'canister' 'heavy' 'unit' 'battery' 'pulsing' 'cell',
       bulk BULK_HEAVY,
       description "The cylinder has come to life. Blue light pulses from the recessed groove, and the casing feels warm.";

Object ChargedCell4 "pulsing cylinder"
  with name 'cylinder' 'canister' 'heavy' 'unit' 'battery' 'pulsing' 'cell',
       bulk BULK_HEAVY,
       description "The cylinder has come to life. Blue light pulses from the recessed groove, and the casing feels warm.";

Object SecurityDrone "Security Drone"
  with name 'drone' 'robot' 'machine' 'patrol', description "A floating sphere of black metal with a glowing red eye and a taser mount.",
       initial "A Security Drone hovers here, scanning for thermal signatures.", has static;

Object Corpse "desiccated corpse"
  with name 'body' 'corpse' 'man' 'crewman' 'dead' 'uniform',
       description [;
            print "A crew member, long dead. He wears a standard technician's uniform.";
            if (Keycard in self) { 
                give Keycard ~concealed; 
                print " You notice a plastic card tucked into his breast pocket."; 
            }
            print "^"; 
            return true;
       ],
       search [;
            return true;
       ],
  has static container open scenery;

Object Keycard "plastic keycard"
  with name 'card' 'key' 'keycard' 'pass',
       bulk BULK_POCKET,
       description [;
           print "A standard plastic ID card. The label reads: ";
           Translate("CERNYV ZRAAV", "ACCESS CARD");
           "."; 
       ],
       after [;
           Take:
               if (self has concealed) {
                   give self ~concealed;
               }
       ],
    has concealed;
Object OpticalModule "bio-chip (green)"
  with name 'driver' 'module' 'chip' 'green' 'wafer',
       bulk BULK_POCKET,
       description "A green bio-chip labeled 'OPTICAL CORTEX LINK v4.0'.",
       before [;
            Wear: <<Install self>>;
            Install:
                if (visual_cortex_active == 1) { print "You already have that upgrade."; rtrue; }
                visual_cortex_active = 1; remove self;
                print "You press the chip into the base of your skull. Your neural link integrates the new visual data.^";
                rtrue;
       ];
Object OpticalModuleFried "fried bio-chip (green)"
  with name 'driver' 'module' 'chip' 'green' 'wafer',
       bulk BULK_POCKET,
       description "A green bio-chip labeled 'OPTICAL CORTEX LINK v4.0'.",
       before [;
            Wear: <<Install self>>;
            Install:
                if (visual_cortex_active == 1) { print "You already have that upgrade."; rtrue; }
                visual_cortex_active = 1; remove self;
                print "You press the chip into the base of your skull. Your neural link integrates the new visual data.^";
                rtrue;
       ];
Object AudioModule "bio-chip (silver)"
  with name 'chip' 'module' 'silver' 'wafer', bulk BULK_POCKET,
       description "A sleek silver bio-chip. It looks like a standard Neural Auditory Processor.",
       before [;
            Wear: <<Install self>>;
            Install:
                if (audio_codec_active == 1) { print "You already have that upgrade."; rtrue; }
                audio_codec_active = 1; remove self;
                print "You slide the chip into the port behind your ear. Your neural link integrates the new data stream.^";
                rtrue;
       ];
Object AudioModuleFried "fried bio-chip (silver)"
  with name 'chip' 'module' 'silver' 'wafer', bulk BULK_POCKET,
       description "A sleek silver bio-chip. It looks like a standard Neural Auditory Processor.",
       before [;
            Wear: <<Install self>>;
            Install:
                if (audio_codec_active == 1) { print "You already have that upgrade."; rtrue; }
                audio_codec_active = 1; remove self;
                print "You slide the chip into the port behind your ear. Your neural link integrates the new data stream.^";
                rtrue;
       ];
Object CotUnmade "unmade cot"
    with name 'bed' 'cot' 'bunk' 'sheets' 'blanket',
    description "Dingy would be a kind way to describe the filthy nest you woke up in."
    has static scenery;


Object EvidenceLocker "evidence locker" SecurityCheck
  with name 'locker' 'evidence' 'cabinet' 'drawer',
       description [;
           print "A secure storage unit for confiscated items. It has a heavy electronic lock. ";
           if (self has open) {
               if (child(self) == nothing) "It is currently empty.";
               "Inside, you see your confiscated belongings.";
           }
           "It is currently sealed tight.";
       ],
       when_closed "A reinforced evidence locker is set into the wall.",
       when_open "The evidence locker stands open, revealing its contents.",
       before [;
           Open:
               if (self has locked) {
                   if (arpi_active == 1) {
                       new_line;
                       print "As you reach for the locker, the electronic bolt slides back with a sharp click. ";
                       ArpiNarrative("The intercom voice speaks up:^",
                                     "Arpi sighs:^");
                        new_line;
                        style underline;
                        ArpiLocker();
                        style roman;
                        new_line;
                       give self ~locked;
                       ! Open continues normally
                   } else {
                       "The locker is firmly sealed. You'll need some way to override the electronic lock.";
                   }
               }
       ],
       daemon [;
           ! If the locker is closed/locked but somehow becomes empty, reset it
           ! Or if the player just took the last item while it was open:
           if (child(self) == nothing && (self hasnt open || self has locked)) {
               give self ~locked ~open;
           }
       ],
  has static container openable locked open; ! Starts open and unlocked