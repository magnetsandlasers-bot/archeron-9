! ==============================================================================
! Objects
! ==============================================================================

Class AlienRoom with short_name [;
    if (visual_cortex_active == 0 && self provides zh_name) {
        print (string) self.zh_name; rtrue;
    }
    rfalse;
], has light;

Class Cylinder
  with  name 'heavy' 'cylinder' 'cylinders' 'battery' 'batteries',
        short_name "heavy cylinder",
        plural "heavy cylinders",
        description "A heavy, inert metal cylinder.",
        before [;
            Receive: <<Receive BatteryShelf noun>>; ! Redirect if put on shelf
        ],
  has   supporter;

Object PlayerCryoTube "open cryo tube"
  with name 'open' 'cryo' 'tube' 'pod' 'glass',
       description [;
           print "This is the tube you woke up in. The bio-monitor display reads: ";
                           Translate("DOMN 009 KRZSHDOSH: VZRAK", "SUBJECT 009 STATUS: REVIVED");

           print "^";
           return true;
       ],
       has static scenery;
Object ClosedCryoTubes "rows of cryo tubes"
  with name 'rows' 'tubes' 'pods' 'closed' 'sealed',
       description "Rows of frosted glass tubes line the walls, glowing with a faint, rhythmic pulse. They appear sealed and dormant, their interiors empty and cold.",
       has static scenery;

Object HighTechJumpsuit "high-tech jumpsuit"
  with name 'jumpsuit' 'suit' 'grey' 'tech', bulk BULK_NORMAL,
       description "A sleek, form-fitting jumpsuit made of a dark grey, advanced material. It feels surprisingly light yet durable. As you look at it, the fabric seems to shimmer invitingly.",
       before [;
            Wear:
                if (jumpsuit_worn == 1) { print "You are already wearing the jumpsuit."; rtrue; }
                jumpsuit_worn = 1; jumpsuit_timer = 0; remove self;
                print "You slip on the jumpsuit. It conforms to your body like a second skin. The advanced nano-material immediately adjusts to your body temperature, providing perfect insulation against the biting cold. You feel secure and protected.^";
                rtrue;
            Remove:
                if (jumpsuit_worn == 1) { print "This suit is not coming off, no matter how hard you try. It's like a second skin, and your fingers can't get a purchase on the fabric."; rtrue; }
       ],
    has clothing concealed;

Object Battery1 "heavy cylinder"
  with name 'battery' 'cell' 'cylinder' 'unit' 'heavy',
       bulk BULK_HEAVY,
       initial "A heavy, dark cylinder lies on the floor.",
       description "It is a dense, cylindrical unit with heavily-scarred contact points on one end. It looks like a part of something larger. There is a recessed groove all around the circumference.";

Object Battery2 "heavy cylinder"
  with name 'battery' 'cell' 'cylinder' 'unit' 'heavy',
       bulk BULK_HEAVY,
       description "It is a dense, cylindrical unit with heavily-scarred contact points on the bottom. It looks like a part of something larger. There is a recessed groove all around the circumference.";

Object Battery3 "heavy cylinder"
  with name 'battery' 'cell' 'cylinder' 'unit' 'heavy',
       bulk BULK_HEAVY,
       description "It is a dense, cylindrical unit with heavily-scarred contact points on the bottom. It looks like a part of something larger. There is a recessed groove all around the circumference.";

Object Battery4 "heavy cylinder"
  with name 'battery' 'cell' 'cylinder' 'unit' 'heavy',
       bulk BULK_HEAVY,
       description "It is a dense, cylindrical unit with heavily-scarred contact points on the bottom. It looks like a part of something larger. There is a recessed groove all around the circumference.";

Object ChargedCell1 "pulsing cylinder"
  with name 'cylinder' 'canister' 'heavy' 'unit' 'battery' 'pulsing' 'cell',
       bulk BULK_HEAVY,
       description "The cylinder has come to life. Blue light pulses from the recessed groove, and the casing feels warm.";

Object ChargedCell2 "pulsing cylinder"
  with name 'cylinder' 'canister' 'heavy' 'unit' 'battery' 'pulsing' 'cell',
       bulk BULK_HEAVY,
       description "The cylinder has come to life. Blue light pulses from the recessed groove, and the casing feels warm.";

Object ChargedCell3 "pulsing cylinder"
  with name 'cylinder' 'canister' 'heavy' 'unit' 'battery' 'pulsing' 'cell',
       bulk BULK_HEAVY,
       description "The cylinder has come to life. Blue light pulses from the recessed groove, and the casing feels warm.";

Object ChargedCell4 "pulsing cylinder"
  with name 'cylinder' 'canister' 'heavy' 'unit' 'battery' 'pulsing' 'cell',
       bulk BULK_HEAVY,
       description "The cylinder has come to life. Blue light pulses from the recessed groove, and the casing feels warm.";

Object SecurityDrone "Security Drone"
  with name 'drone' 'robot' 'machine' 'patrol', description "A floating sphere of black metal with a glowing red eye and a taser mount.",
       initial "A Security Drone hovers here, scanning for thermal signatures.", has static;

Object Corpse "desiccated corpse"
  with name 'body' 'corpse' 'man' 'crewman' 'dead' 'uniform',
       description [;
            print "A crew member, long dead. He wears a standard technician's uniform.";
            if (Keycard in self) { 
                give Keycard ~concealed; 
                print " You notice a plastic card tucked into his breast pocket."; 
            }
            print "^"; 
            return true;
       ],
       search [;
            return true;
       ],
  has static container open scenery;

Object Keycard "plastic keycard"
  with name 'card' 'key' 'keycard' 'pass',
       bulk BULK_POCKET,
       description [;
           print "A standard plastic ID card. The label reads: ";
           Translate("CERNYV ZRAAV", "ACCESS CARD");
           "."; ! This adds the final period and newline
       ],
    has concealed;

Object OpticalModule "bio-chip (green)"
  with name 'driver' 'module' 'chip' 'green' 'wafer',
       bulk BULK_POCKET,
       description "A green bio-chip labeled 'OPTICAL CORTEX LINK v4.0'.",
       before [;
            Wear: <<Install self>>;
            Install:
                if (visual_cortex_active == 1) { print "You already have that upgrade."; rtrue; }
                visual_cortex_active = 1; remove self;
                print "You press the chip into the base of your skull. Your neural link integrates the new visual data.^";
                rtrue;
       ];

Object AudioModule "bio-chip (silver)"
  with name 'chip' 'module' 'silver' 'wafer', bulk BULK_POCKET,
       description "A sleek silver bio-chip. It looks like a standard Neural Auditory Processor.",
       before [;
            Wear: <<Install self>>;
            Install:
                if (audio_codec_active == 1) { print "You already have that upgrade."; rtrue; }
                audio_codec_active = 1; remove self;
                print "You slide the chip into the port behind your ear. Your neural link integrates the new data stream.^";
                rtrue;
       ];