Object BrokenDrone "broken drone"
  with name 'broken' 'disassembled' 'drone' 'robot' 'machine' 'patrol' 'sphere', 
       description "An inert sphere of black metal, split open to reveal its insides.",
       initial "A broken drone sits here.",
  has static container open scenery;
AVModule AVModule1 "bio-chip (silver)"
    ;
AVModule AVModule2 "bio-chip (silver)"
    ;
Object AVModuleFried "fried bio-chip (silver)"
  with name 'chip' 'module' 'silver' 'wafer' 'fried',
       bulk BULK_POCKET,
       chip_timer 0,  ! This uses the Property you just created
       is_installed false,
       description [;
            if (self.chip_timer >= 10) "A useless piece of slagged silver electronics.";
            "A sleek silver bio-chip. It looks like a standard Neural Auditory Processor.";
       ],
       before [;
            Wear, Install:
                if (self.chip_timer >= 10) "The chip is burnt out and won't interface with your port.";
                if (AV_codec_active == 1) "You already have a working translation matrix active.";
                
                AV_codec_active = 1; 
                self.is_installed = true;
                StartDaemon(self);
                remove self; ! Pulls it from inventory into 'nowhere' while installed
                "You slide the chip into the port behind your ear, and your neural link integrates the new data stream. You blink, and your vision seems to shift focus for a moment. Your hearing gets muffled in one ear after another, then pings into clarity.^^";
       ],
       daemon [;
            if (self.is_installed == false) return;
            self.chip_timer++;

            ! Phase 1: Turns 1-3 (Flawless)
            if (self.chip_timer == 1) { 
                AV_codec_active = 1; 
                print "You hear a familiar voice on the intercom!";
                style underline;
                print "~You did it! You should be able to understand me now, finally! I'm called Arpi.~";
                new_line;
                style roman;
            }
                if (self.chip_timer == 4) { 
                AV_codec_active = 1; 
                print "A touch of concern tinges Arpi's voice.";
                style underline;
                print "~Did you notice that? I caught something strange in our linkup.~";
                new_line;
                style roman;
            }
            ! Phase 2: Turns 5-8 (50/50 Flicker)
            if (self.chip_timer >= 5 && self.chip_timer < 9) {
                if (random(100) <= 50) AV_codec_active = 1;
                else AV_codec_active = 0;
            }
            if (self.chip_timer == 9) { 
                AV_codec_active = 1; 
                print "A touch of concern has matured into laser focus.";
                style underline;
                print "~Something is definitely wrong here. i Vzrac Stavr-Ulmk zraavek y Stavrak must have had its AV codecs fried. I'm getting y Tlkz-Smrnk zraavek y Zgrtulmk vo i Cernyv-Jadroz.~";
                new_line;
                style roman;
            }
            ! Phase 3: Turns 9-11 (70/30 Failure - Weighted towards 0)
            if (self.chip_timer >= 9 && self.chip_timer < 11) {
                if (random(100) <= 30) AV_codec_active = 1; ! Only 30% chance to work
                else AV_codec_active = 0;

            }

            ! The Ejection: Turn 12
            if (self.chip_timer >= 12) {
                StopDaemon(self);
                AV_codec_active = 0; ! Permanent failure
                self.is_installed = false;
                new_line;
                style roman;
                "With a sharp mechanical click, the chip physically ejects from your port, falling to the floor and bouncing away into a crevice. It's gone.";
            }
       ];

Object CotUnmade "unmade cot" Brig
    with name 'bed' 'cot' 'bunk' 'sheets' 'blanket',
    description "Dingy would be a kind way to describe the filthy nest you woke up in. The dark and dusty space underneath the cot looks as if it has been disturbed recently.",
    before [;
        LookUnder, Search:
            if (LooseGrating.is_found == false) {
                LooseGrating.is_found = true;
                "Peering under the bed, you notice a loose metal grating tucked against the wall. From the way the dust has been disturbed, it looks like someone or something has been in there.";
            }
            "You see the loose grating you found earlier.";
    ]
    has static scenery;

Object EvidenceLocker "evidence locker" SecurityCheck
  with name 'locker' 'evidence' 'cabinet' 'drawer',
       description [;
           print "A secure storage unit with a serious-looking electronic lock. ";
           if (self has open) {
               if (child(self) == nothing) "It is currently empty.";
               "Inside, you see your confiscated belongings.";
           }
           "It is currently sealed tight.";
       ],
       when_closed [;
           print "A reinforced locker is set into the wall under a sign reading ";
           TranslateAV("KOVRAZHSK." , "EVIDENCE.");
       ],
       before [;
           Open:
               ! 1. If it's already open, let the system handle it
               if (self has open) rfalse;

               ! 2. The Logic: If it has items, Arpi/The Computer unlocks it
               if (child(self) ~= nothing) {
                   if (self has locked) {
                       give self ~locked;
                       print "As you reach for the locker, the electronic bolt slides back with a sharp click. ";
                       if (arpi_active == 1) {
                           ArpiNarrative("The intercom voice speaks up:^", "Arpi sighs:^");
                           style underline;
                           ArpiLocker();
                           style roman;
                       }
                       new_line;
                       ! The 'Open' action continues and the locker opens.
                   }
               } else {
                   ! 3. If it's empty, it stays locked.
                   "The locker is firmly sealed.";
               }
       ],
       after [;
           Close:
               ! Automatically re-lock it when closed if it's empty
               if (child(self) == nothing) {
                   give self locked;
                   print "^The locker clicks shut and the electronic lock re-engages immediately.^";
               }
       ],
  has static container openable locked; ! Added 'openable' so the player can use the 'open' command

Object Arpi "Arpi"
    with parse_name [;
        ! If player is not aware, Arpi has no recognizable name
        if (arpi_aware == 0) return 0; 
        ! If they are aware, recognize these words
        if (NextWord() == 'arpi' or 'voice' or 'system' or 'ai') return 1;
        return 0;
    ],
    found_in [;
        if (location provides arpi_access && location.arpi_access == 1) rtrue;
        rfalse;
    ],
    daemon ArpiDaemon,
    description "Arpi's voice emanates from the ship's integrated speaker network.",
    life [;
            Ask:
                switch (second) {
                    ! --- STOCK ANSWERS ---
                    'arpi', 'self', 'name': return ArpiWhoAreYou();
                    'ship', 'vessel', 'location': return ArpiShipStatus();
                    'mission', 'objective', 'task', 'goal', 'purpose': return ArpiMission();
                    'object', 'thing': return ArpiObject();
                    'loudspeaker', 'announcements', 'warnings', 'danger': return ArpiDanger();

                    ! --- ROOM-SPECIFIC ANSWERS ---
                !    'presence', 'unauthorized', 'biometric':
                 !       if (location == DronePort) return ArpiDronePortResponse();
                 !       "~I detect no unusual signatures in this specific area.~";
                    
                    default:
                        "~I have no relevant data regarding '", (address) WordAddress(wn-1), "' at this time.~";
                }
        ],
    has animate scenery;
