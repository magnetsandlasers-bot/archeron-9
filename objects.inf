! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Object SecurityDrone "security drone"
  with name 'drone' 'robot' 'machine' 'patrol' 'sphere', 
       description "A floating sphere of black metal with a glowing red eye.",
       initial "A Security Drone hovers here, scanning for thermal signatures.",
       before [;
            Open:
                if (drone_active == 1) {
                    "You try to grab the hovering machine, but it emits a sharp 
                    electric spark that forces you to back off. It's not going 
                    to let you poke around its internals while it's powered on.";
                }
                ! If drone_active is 0, the library takes over and opens it normally.
       ],
  has static container openable;
Object BrokenDrone "broken drone"
  with name 'drone' 'robot' 'machine' 'patrol' 'sphere', 
       description "An inert sphere of black metal, split open to reveal its insides.",
       initial "A broken drone sits here.",
  has static container open;
! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Object OpticalModule "bio-chip (green)"
  with name 'driver' 'module' 'chip' 'green' 'wafer',
       bulk BULK_POCKET,
       description "A green bio-chip labeled 'OPTICAL CORTEX LINK v4.0'.",
       before [;
            Wear: <<Install self>>;
            Install:
                if (visual_cortex_active == 1) { print "You already have that upgrade."; rtrue; }
                visual_cortex_active = 1; remove self;
                print "You press the chip into the base of your skull. Your neural link integrates the new visual data.^";
                rtrue;
       ];
Object OpticalModuleFried "fried bio-chip (green)"
  with name 'driver' 'module' 'chip' 'green' 'wafer',
       bulk BULK_POCKET,
       description "A green bio-chip labeled 'OPTICAL CORTEX LINK v4.0'.",
       before [;
            Wear: <<Install self>>;
            Install:
                if (visual_cortex_active == 1) { print "You already have that upgrade."; rtrue; }
                visual_cortex_active = 1; remove self;
                print "You press the chip into the base of your skull. Your neural link integrates the new visual data.^";
                rtrue;
       ];
