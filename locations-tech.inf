AlienRoom SpineFore "Spine Fore"
  with zh_name "POHYB STAVR PRE",
       description [;
           print "Another segment of the long, dark corridor. The emergency lights flicker erratically. The corridor continues North.";
           if (bulkhead_passed == 0 && BulkheadDoor hasnt locked) {
               print " To the South, the bulkhead door stands open.";
           } else {
               print " To the South, the bulkhead door is closed.";
           }
           print "^";
           return true;
       ],
       n_to SpineMid, s_to BulkheadDoor,
       after [;
           Go:
               if (noun == n_to && bulkhead_passed == 0) {
                   bulkhead_passed = 1;
                   print "^As you step forward into the main ship, you hear a heavy CLUNK behind you. The bulkhead door has closed and sealed itself. You're committed now.^";
                   give BulkheadDoor locked;
               }
       ];

AlienRoom SpineMid "Spine Mid"
  with zh_name "POHYB STAVR SRED",
       description "The central segment of the spine corridor. The air here feels colder, and the emergency lights are almost completely dead. The corridor continues North and South.",
       s_to SpineFore, n_to Atrium;

AlienRoom Atrium "Central Atrium"
  with zh_name "JADROZ POHYB",
       description "A massive, multi-level atrium. Exits lead North, South, East, and West. A freight elevator leads Down.",
       s_to SpineMid, e_to MessHall, w_to SecurityCheck, n_to BridgeDoor, d_to CargoBay;

AlienRoom SecurityCheck "Security Checkpoint"
  with zh_name "VZRAC ZAMER",
       description [;
           print "A reinforced checkpoint. Exits lead East and West. To the North, a heavy, reinforced door leads to what appears to be a detention area.^";
           return true;
       ],
       e_to Atrium, w_to OpsCenter, n_to BrigDoor;

AlienRoom OpsCenter "Ops Center"
  with zh_name "KRZHDYN VZRAC",
       description "Banks of monitors display the ship's status. A Recall Terminal sits here. Exits lead North, South, and East.",
       e_to SecurityCheck, n_to ServerRoom, s_to CommsRelay;

AlienRoom CommsRelay "Comms Relay"
  with zh_name "STYRZEN POHYB",
       description "Banks of radio equipment line the walls. The air hums with static. The exit is North.",
       n_to OpsCenter;
Object -> AudioModule "bio-chip (silver)"
  with name 'chip' 'module' 'silver' 'wafer', bulk BULK_POCKET,
       description "A sleek silver bio-chip. It looks like a standard Neural Auditory Processor.",
       before [;
            Wear: <<Install self>>;
            Install:
                if (audio_codec_active == 1) { print "You already have that upgrade."; rtrue; }
                audio_codec_active = 1; remove self;
                print "You slide the chip into the port behind your ear. Your neural link integrates the new data stream.^";
                rtrue;
       ];

AlienRoom ServerRoom "Server Room"
  with zh_name "CERNYV STYRZ",
       description "Rows of server banks hum quietly. The exit is South.",
       s_to OpsCenter;
Object -> OpticalModule "bio-chip (green)"
  with name 'driver' 'module' 'chip' 'green' 'wafer', bulk BULK_POCKET,
       description "A green bio-chip labeled 'OPTICAL CORTEX LINK v4.0'.",
       before [;
            Wear: <<Install self>>;
            Install:
                if (visual_cortex_active == 1) { print "You already have that upgrade."; rtrue; }
                visual_cortex_active = 1; remove self;
                print "You press the chip into the base of your skull. Your neural link integrates the new visual data.^";
                rtrue;
       ];
Object -> ServerTerminal "main terminal"
  with name 'terminal' 'computer' 'screen' 'code' 'image' 'qr' 'glyph',
       qr_content "PROTOCOL 99-DELTA: To override Subject status, insert a standard Admin Wafer into the slot.",
       description [;
            print "The screen displays the ship's crew manifest. ";
            if (visual_cortex_active == 0) print "Your vision cannot parse the glyphs.";
            else {
                 print "CURRENT USER: ID 009. RANK: UNLISTED.";
                 if (identity_hacked) print "^STATUS: OVERRIDDEN (COMMANDER ACCESS).";
                 last_qr_source = self;
                 print "^^[ENCRYPTED DATA DETECTED. BLINK TWICE TO DECRYPT]";
            }
            print "^"; return true;
       ], has static scenery;
Object -> TerminalSlot "data slot"
  with name 'slot' 'drive' 'reader', description "A slot designed for a standard Admin Data Wafer.",
       before [;
            Receive:
                if (noun == DataWafer) {
                    if (visual_cortex_active == 0) { print "You cannot parse the terminal interface to perform the hack.^"; rtrue; }
                    remove DataWafer; identity_hacked = 1;
                    print "You insert the wafer. You overwrite the 'UNLISTED' tag with 'COMMANDER'.^";
                    rtrue;
                }
       ], has static container open scenery;
AlienRoom ServerFarm "Server Farm"
  with zh_name "STYRZEN JADROZ",
       description "Towering black server racks. The exit is South.", s_to OpsCenter;

! --- NEW ROOM: Brig ---
AlienRoom Brig "Security Brig"
  with zh_name "ZAMER DRAZK",
       description [;
           print "A small, heavily reinforced room. A single, uncomfortable-looking cot is bolted to the far wall. The air is cold and stale. The only exit is South, through a thick door.^";
           return true;
       ],
       s_to BrigDoor;

! --- NEW DOOR: BrigDoor ---
Object BrigDoor "reinforced door"
  with name 'door' 'brig' 'reinforced' 'security' 'north' 'south',
       description [;
            if (location == SecurityCheck) {
                print "A heavy, reinforced door with a glowing red panel and a keycard slot.";
                if (power_restored == 0) print " The panel is dark and unresponsive.";
                else { print " The panel reads: "; PrintVisual("DRAZKOSH ZAMEROSH"); }
            } else { ! From inside the Brig
                print "The inner face of the door is smooth, unyielding metal with no visible controls or seams.";
            }
            print "^"; return true;
       ],
       before [;
            Unlock, Open:
                if (location == Brig) { print "There's no way to open the door from in here."; rtrue; }
                if (power_restored == 0) { print "The electronic lock is dead."; rtrue; }
       ],
       found_in SecurityCheck Brig,
       door_dir [; if (location == SecurityCheck) return n_to; return s_to; ],
       door_to [; if (location == SecurityCheck) return Brig; return SecurityCheck; ],
       with_key Keycard,
       has static door openable lockable locked scenery;