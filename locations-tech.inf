AlienRoom SpineFore "Spine Fore"
  with zh_name "POHYB STAVR PRE",
       description [;
           print "Another segment of the long, dark corridor. The emergency lights flicker erratically. The corridor continues North.";
           if (BulkheadDoor has open) {
               print " To the South, the bulkhead door stands open.";
           } else {
               print " To the South, the bulkhead door is closed.";
           }
           print "^";
           return true;
       ],
       n_to SpineMid, s_to BulkheadDoor,
       after [;
           if (bulkhead_passed == 0) {
               bulkhead_passed = 1;
               give BulkheadDoor ~open locked;
               print "^^As you step into the forward section, you hear a heavy CLUNK behind you. The bulkhead door slams shut and seals itself. You're committed now.^";
           }
       ];
AlienRoom SpineMid "Spine Mid"
  with zh_name "POHYB STAVR SRED",
       description "The central segment of the spine corridor. The air here feels colder, and the emergency lights are almost completely dead. The corridor continues North and South.",
       s_to SpineFore, 
       n_to Atrium;
AlienRoom Atrium "Central Atrium"
  with zh_name "JADROZ POHYB",
       description "A massive, multi-level atrium. Exits lead North, South, East, and West. A freight elevator leads down. ",
       s_to SpineMid, e_to MessHall, w_to SecurityCheck, n_to BridgeDoor, d_to CargoBay;

AlienRoom SecurityCheck "Security Checkpoint"
  with zh_name "VZRAC ZAMER",
       description [;
           print "A reinforced checkpoint. Exits lead East and West. To the North, a heavy, reinforced door leads to what appears to be a detention area.^";
           return true;
        
       ],
       e_to Atrium, w_to OpsCenter, n_to BrigDoor;

AlienRoom OpsCenter "Ops Center"
  with zh_name "KRZHDYN VZRAC",
       description "Banks of monitors display the ship's status. A Recall Terminal sits here. Exits lead North, Northwest, South, and East.",
       e_to SecurityCheck,
       n_to ServerRoom,   ! Leads to the terminal and chips
       w_to DroneWorkshop,
       s_to CommsRelay;

AlienRoom CommsRelay "Comms Relay"
  with zh_name "STYRZEN POHYB",
       description "Banks of radio equipment line the walls. The air hums with static. The exit is North.",
       n_to OpsCenter;

AlienRoom ServerRoom "Server Room"
  with zh_name "CERNYV STYRZ",
       description "Rows of server banks hum quietly. The exit is South. A short stairway leads up to a small landing." ,
       s_to OpsCenter,
       u_to Landing;

AlienRoom Landing "Landing"
    with zh_name "KAELTH",
        description "A landing in a stairwell. There is a locked door on the West wall. You can go up or down.",
        u_to ServerFarm1,
        d_to ServerRoom;



! --- 2. THE TERMINAL (Explicitly placed in ServerFarm) ---
Object ServerTerminal "main terminal" ServerFarm
  with name 'terminal' 'computer' 'screen' 'code' 'image' 'qr' 'glyph',
       qr_content "PROTOCOL 99-DELTA: To override Subject status, insert a standard Admin Wafer into the slot.",
       description [;
            print "The screen displays the ship's crew manifest. ";
            if (visual_cortex_active == 0) print "Your vision cannot parse the glyphs.";
            else {
                 print "CURRENT USER: ID 009. RANK: UNLISTED.";
                 if (identity_hacked) print "^STATUS: OVERRIDDEN (COMMANDER ACCESS).";
                 last_qr_source = self;
                 print "^^[ENCRYPTED DATA DETECTED. BLINK TWICE TO DECRYPT]";
            }
            print "^"; return true;
       ],
       has static scenery;

! --- 3. THE SLOT (Nested INSIDE the terminal) ---
Object -> TerminalSlot "data slot"
  with name 'slot' 'drive' 'reader',
       description "A slot designed for a standard Admin Data Wafer.",
       before [;
            Receive:
                if (noun == DataWafer) {
                    if (visual_cortex_active == 0) { print "You cannot parse the terminal interface to perform the hack.^"; rtrue; }
                    remove DataWafer; identity_hacked = 1;
                    print "You insert the wafer. You overwrite the 'UNLISTED' tag with 'COMMANDER'.^";
                    rtrue;
                }
       ],
       has static container open scenery;

AlienRoom Brig "Security Brig"
  with zh_name "ZAMER DRAZK",
       description [;
           print "A small, heavily reinforced room. A single, uncomfortable-looking cot is bolted to the far wall. The air is cold and stale. The only exit is South, through a thick door.^";
           return true;
       ],
       s_to BrigDoor,
       daemon [;
           if (brig_timer > 0) {
               brig_timer--;
               if (brig_timer == 0) {
                   StopDaemon(self);
                   give BrigDoor ~locked;
                   give BrigDoor open;
                   
                   ! Trigger the exit dialogue
                   new_line;
                   ArpiBrig2(); 

                   ! Final atmospheric text
                    style roman;
                    new_line;
                    print "With a heavy clunk and a hiss of pneumatics, the reinforced door's locking bolts retract and the heavy slab of metal slides open. The status light on the intercom shifts from red to a dull green.^";
               }
           }
       ];
AlienRoom DroneWorkshop "Drone Workshop"
    with zh_name "VZRAC MAJSTRZ",
           description "This is a small workshop that looks like it must be used for working on security drones. On a workbench you see a half-disassembled drone and a heavy, dark cylinder. One of the charging units is on the south wall, its cylindrical slot empty. Next to it, another station looks to be powered by one of the pulsing cylinders. This station has an opening that looks like it could accomodate one of the drones.",
           e_to OpsCenter;
