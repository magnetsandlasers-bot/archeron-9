Object OpticalModuleFried "fried bio-chip (green)"
  with name 'driver' 'module' 'chip' 'green' 'wafer',
       bulk BULK_POCKET,
       description "A green bio-chip labeled 'OPTICAL CORTEX LINK v4.0'.",
       before [;
            Wear: <<Install self>>;
            Install:
                if (visual_cortex_active == 1) { print "You already have that upgrade."; rtrue; }
                visual_cortex_active = 1; remove self;
                print "You press the chip into the base of your skull. Your neural link integrates the new visual data.^";
                rtrue;
       ];

Object OpticalModule1 "bio-chip (green)"
  with name 'driver' 'module' 'chip' 'green' 'wafer',
       bulk BULK_POCKET,
       description "A green bio-chip labeled 'OPTICAL CORTEX LINK v4.0'.",
       before [;
            Wear: <<Install self>>;
            Install:
                if (visual_cortex_active == 1) { 
                    "You already have that upgrade."; 
                }
                visual_cortex_active = 1;
                installed_optical_chip = self; ! Store the object ID (OpticalModule1)
                remove self;
                "You press the chip into the base of your skull. Your neural link integrates the new visual data.";
       ];
Object OpticalModule2 "bio-chip (green)"
  with name 'driver' 'module' 'chip' 'green' 'wafer',
       bulk BULK_POCKET,
       description "A green bio-chip labeled 'OPTICAL CORTEX LINK v4.0'.",
       before [;
            Wear: <<Install self>>;
            Install:
                if (visual_cortex_active == 1) { 
                    "You already have that upgrade."; 
                }
                visual_cortex_active = 1;
                installed_optical_chip = self; ! Store the object ID (OpticalModule1)
                remove self;
                "You press the chip into the base of your skull. Your neural link integrates the new visual data.";
       ];

AVModule AudioModule1 "bio-chip (silver)"
  with name 'chip' 'module' 'silver' 'wafer', 
       bulk BULK_POCKET,
       description "A sleek silver bio-chip. It looks like a standard Neural Auditory Processor.",
       before [;
            Wear: <<Install self>>;
            Install:
                if (AV_codec_active == 1) { print "You already have that upgrade."; rtrue; }
                AV_codec_active = 1;
                installed_audio_chip = self;
                remove self;
                print "You slide the chip into the port behind your ear. Your neural link integrates the new data stream.^";
                rtrue;
       ];

Object AudioModule2 "bio-chip (gold)"
  with name 'chip' 'module' 'gold' 'wafer', 
       bulk BULK_POCKET,
       description "A sleek gold bio-chip. It looks like a standard Neural Auditory Processor.",
       before [;
            Wear: <<Install self>>;
            Install:
                if (AV_codec_active == 1) { print "You already have that upgrade."; rtrue; }
                AV_codec_active = 1;
                installed_audio_chip = self;
                remove self;
                print "You slide the chip into the port behind your ear. Your neural link integrates the new data stream.^";
                rtrue;
       ];




 [ TranslateVisual str_alien str_human;
    if (AV_codec_active) {
        print (string) str_human;
    } else {
        print (string) str_alien;
    }
    rtrue;
    ];      

Object AVModuleFried "fried bio-chip (silver)"
  with name 'chip' 'module' 'silver' 'wafer', bulk BULK_POCKET,
       description "A sleek silver bio-chip. It looks like a standard Neural Auditory Processor.",
       before [;
            Wear: <<Install self>>;
            Install:
                if (AV_codec_active == 1) { print "You already have that upgrade."; rtrue; }
                AV_codec_active = 1; remove self;
                print "You slide the chip into the port behind your ear. Your neural link integrates the new data stream.^";
                rtrue;
       ];


[ ArpiDaemon;
    ! Check if Arpi is active AND the player is in an Archeron-class room
    if (arpi_active == 1 && location ofclass ArcheronRoom) {
        
        ! We only trigger the random chatter if Arpi is in a 'normal' state
        if (Arpi.arpi_state == 1 && random(10) == 1) { 
            new_line;
            print "Arpi's voice hums through the bulkhead speakers. ";
            ! You can even vary the message based on the specific room
            switch(location) {
                ServerRoom: "'Navigational arrays are locking to the nearest pulsar.'";
                MedBay: "'Biological scans indicate your heart rate is slightly elevated.'";
                default: "'Atmospheric scrubbers are operating at peak efficiency.'";
            }
            new_line;
        }
    }
    ];

    Class SecurityDrone
  with name 'drone' 'robot' 'machine' 'sphere', 
       description [;
           if (self.is_active == 1) 
               "A floating sphere of black metal with a glowing red eye.";
           "An inert sphere of black metal. Its red eye is dark. Its carapace has a seam down the middle, which looks like it could be opened fairly easily.";
       ],
       describe [;
    ! 1. Silence drones in the workshop
    if (location == DroneWorkshop) rtrue;

    ! 2. Identify the "other" drone
    other_drone = SecurityDrone1;
    if (self == SecurityDrone1) other_drone = SecurityDrone2;

    ! 3. Handle the "Paired" logic (only if both are in the same room)
    if (parent(other_drone) == parent(self)) {
        ! If both are in the room, only the first drone speaks
        if (self == SecurityDrone2) rtrue; 

        if (self.is_active == 1 && other_drone.is_active == 1)
            "Two security drones hover here, their red eyes scanning the room.";
        
        "A live security drone hovers here, examining its fallen comrade.";
    }

    ! 4. Handle the "Single" logic (if only one drone is present)
    if (self.is_active == 1) 
        "A security drone hovers here, scanning for thermal signatures.";
    
    "A dead security drone lies on the floor.";
],
       move_count 0,
       is_active 1, 
       drone_alert 0,
       before [;
            Open:
                if (self.is_active == 1) {
                    "You consider grabbing the drone right out of the air, but think the better of it. You've just gotten used to having fingers.";
                }
       ],
  has static container openable;

