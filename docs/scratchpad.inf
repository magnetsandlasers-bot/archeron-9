Object OpticalModuleFried "fried bio-chip (green)"
  with name 'driver' 'module' 'chip' 'green' 'wafer',
       bulk BULK_POCKET,
       description "A green bio-chip labeled 'OPTICAL CORTEX LINK v4.0'.",
       before [;
            Wear: <<Install self>>;
            Install:
                if (visual_cortex_active == 1) { print "You already have that upgrade."; rtrue; }
                visual_cortex_active = 1; remove self;
                print "You press the chip into the base of your skull. Your neural link integrates the new visual data.^";
                rtrue;
       ];

Object OpticalModule1 "bio-chip (green)"
  with name 'driver' 'module' 'chip' 'green' 'wafer',
       bulk BULK_POCKET,
       description "A green bio-chip labeled 'OPTICAL CORTEX LINK v4.0'.",
       before [;
            Wear: <<Install self>>;
            Install:
                if (visual_cortex_active == 1) { 
                    "You already have that upgrade."; 
                }
                visual_cortex_active = 1;
                installed_optical_chip = self; ! Store the object ID (OpticalModule1)
                remove self;
                "You press the chip into the base of your skull. Your neural link integrates the new visual data.";
       ];
Object OpticalModule2 "bio-chip (green)"
  with name 'driver' 'module' 'chip' 'green' 'wafer',
       bulk BULK_POCKET,
       description "A green bio-chip labeled 'OPTICAL CORTEX LINK v4.0'.",
       before [;
            Wear: <<Install self>>;
            Install:
                if (visual_cortex_active == 1) { 
                    "You already have that upgrade."; 
                }
                visual_cortex_active = 1;
                installed_optical_chip = self; ! Store the object ID (OpticalModule1)
                remove self;
                "You press the chip into the base of your skull. Your neural link integrates the new visual data.";
       ];

AVModule AudioModule1 "bio-chip (silver)"
  with name 'chip' 'module' 'silver' 'wafer', 
       bulk BULK_POCKET,
       description "A sleek silver bio-chip. It looks like a standard Neural Auditory Processor.",
       before [;
            Wear: <<Install self>>;
            Install:
                if (AV_codec_active == 1) { print "You already have that upgrade."; rtrue; }
                AV_codec_active = 1;
                installed_audio_chip = self;
                remove self;
                print "You slide the chip into the port behind your ear. Your neural link integrates the new data stream.^";
                rtrue;
       ];

Object AudioModule2 "bio-chip (gold)"
  with name 'chip' 'module' 'gold' 'wafer', 
       bulk BULK_POCKET,
       description "A sleek gold bio-chip. It looks like a standard Neural Auditory Processor.",
       before [;
            Wear: <<Install self>>;
            Install:
                if (AV_codec_active == 1) { print "You already have that upgrade."; rtrue; }
                AV_codec_active = 1;
                installed_audio_chip = self;
                remove self;
                print "You slide the chip into the port behind your ear. Your neural link integrates the new data stream.^";
                rtrue;
       ];




 [ TranslateVisual str_alien str_human;
    if (AV_codec_active) {
        print (string) str_human;
    } else {
        print (string) str_alien;
    }
    rtrue;
    ];      

Object AVModuleFried "fried bio-chip (silver)"
  with name 'chip' 'module' 'silver' 'wafer', bulk BULK_POCKET,
       description "A sleek silver bio-chip. It looks like a standard Neural Auditory Processor.",
       before [;
            Wear: <<Install self>>;
