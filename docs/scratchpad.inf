Class ExamChair 
    with name 'chair' 'exam' 'seat',
    short_name "exam chair",
    description [;
        if (player in self) {
            "A chair with a chinrest and a forehead brace, designed to hold a person's head perfectly still. A softly glowing monitor is mounted directly in front of the seat.";
        }
        "A chair with a chinrest and a forehead brace, designed to hold a person's head perfectly still. A softly glowing monitor is mounted directly in front of the seat.";
    ],
    after [;
        Enter:
            if (RetinalScanner in player && JeeJah in player) {
                "You settle into the chair. The monitor pulses green, recognizing both components. You are ready to begin.";
            }
            if (JeeJah in player) {
                print "As you sit down, the JeeJah in your pocket gives a sharp, sustained buzz, signaling that the machine has detected its presence.^";
                "The monitor activates, showing a silent film of a technician demonstrating how to wear the retinal goggles.";
            }
            "You sit in the chair. The monitor flickers on, displaying a 'Required Hardware Missing' error with icons of goggles and a handheld glass pane.";
    ],
    has static enterable supporter;
Class Monitor "monitor"
    with name 'monitor' 'screen' 'display',
    description [;
        ! Find the chair in the same room as this monitor
        local obj chair;
        objectloop (obj in parent(self) && obj ofclass ExamChair) {
            chair = obj;
            break;
        }
        
        if (chair == 0 || player notin chair)
            "You can't really see it clearly unless you sit in the chair.";
        
        if (RetinalScanner in player && JeeJah in player)
            "The monitor displays a step-by-step guide for the retinal scan.";
        
        if (JeeJah in player)
            "The monitor flickers to life, playing a short looped video of goggles being put on.";
        
        "The monitor shows diagrams of goggles and a rectangular glass device.";
    ],
    has static;