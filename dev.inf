! ==============================================================================
! DEV.INF - Logic Routines
! ==============================================================================

[ DevMenuSub;
    print "^--- [ SYSTEM DIAGNOSTICS ] ---^";
    print "Power: ", power_restored, " | Lockdown: ", lockdown_lifted, "^";
    print "Visual: ", visual_cortex_active, " | Audio: ", audio_codec_active, "^";
    "-------------------------------";
];

[ ToggleSub w;
    wn = consult_from; ! Set the word number to where the 'topic' starts
    w = NextWord();    ! Grab the word typed after 'toggle'

    if (w == 'power') power_restored = 1 - power_restored;
    else if (w == 'lockdown') lockdown_lifted = 1 - lockdown_lifted;
    else if (w == 'visual' or 'cortex') visual_cortex_active = 1 - visual_cortex_active;
    else if (w == 'audio' or 'codec') audio_codec_active = 1 - audio_codec_active;
    else { "Toggle what? (power, lockdown, visual, audio)"; }
    
    print "System toggled.^";
    <<DevMenu>>;
];

[ WarpSub;
    if (noun == 0) "You must name a room to warp to.";
    if (noun == player) "You are already where you are.";
    
    PlayerTo(noun);
    ! No need to print "Warping..." the <<Look>> will show the new room.
    <<Look>>;
];

[ AnyRoom;
    switch (scope_stage) {
        1: rfalse;
        2: ScopeWithin(LibraryMessages); ! This forces the parser to see everything
           rtrue;
        3: "You can't see any such place.";
    }
];

[ HealSub;
    power_restored = 1; lockdown_lifted = 1; 
    visual_cortex_active = 1; audio_codec_active = 1;
    "All systems stabilized.^";
];