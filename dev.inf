! ==============================================================================
! Developer Tools
! ==============================================================================

[ DevBrigSub; CapturePlayer(); ];
Verb 'testbrig' * -> DevBrig;

[ DevMenuSub;
    print "^--- [ SYSTEM DIAGNOSTICS ] ---^";
    print "Main Power: ", power_restored, " | Med Power:  ", medical_wing_powered, "^";
    print "Lockdown:   ", lockdown_lifted, " | Bulkhead:   ", bulkhead_passed, "^";
    print "Visual:     ", visual_cortex_active, " | Audio:      ", audio_codec_active, "^";
    print "Identity:   ", identity_hacked, " | Arpi Aware: ", arpi_aware, "^";
        
    "-------------------------------";
    ];

[ ToggleSub w;
    wn = consult_from;
    w = NextWord();

    if (w == 'power') power_restored = 1 - power_restored;
    else if (w == 'med') medical_wing_powered = 1 - medical_wing_powered;
    else if (w == 'lockdown') lockdown_lifted = 1 - lockdown_lifted;
    else if (w == 'visual' or 'cortex') visual_cortex_active = 1 - visual_cortex_active;
    else if (w == 'audio') audio_codec_active = 1 - audio_codec_active;
    else if (w == 'bulkhead') bulkhead_passed = 1 - bulkhead_passed;
    else if (w == 'id' or 'identity' or 'hack') identity_hacked = 1 - identity_hacked;
    else if (w == 'arpi') arpi_aware = 1 - arpi_aware;
    else { 
        "Toggle what? (power, medical, lockdown, visual, audio, bulkhead, identity)"; 
    }
    
    print "System toggled.^";
    <<DevMenu>>;
];

[ WarpSub;
    ! We manually check the next word in the input buffer
    wn = consult_from;
    switch (NextWord()) {
        'bridge': PlayerTo(Bridge);
        'spine': PlayerTo(SpineMid);
        'med', 'medbay': PlayerTo(MedicalBay);
        'eng', 'engineering': PlayerTo(Engineering);
        'cargo': PlayerTo(CargoBay);
        'home' : PlayerTo(CryoBay);
        'drone' : PlayerTo(DroneWorkshop);
        'terminal': PlayerTo(ServerTerminal);
        default: "Teleport failed. Use: WARP [bridge, spine, med, eng, cargo, home, drone, terminal]";
    }
];

[ HealSub;
    power_restored = 1; 
    lockdown_lifted = 1; 
    arpi_aware = 1;
    "All systems stabilized.";
];