ArcheronRoom Bridge "The Bridge"
  with zh_name "VZDRAK SMRNK",
       description "The central area of the command deck. The viewport shows a massive reddish planet looming close. A heavy door leads South. The bridge stretches east and west, with more consoles lining the walls.",
       s_to BridgeDoor,
       e_to EastBridge,
       w_to WestBridge;
ArcheronRoom EastBridge "East Bridge"
  with zh_name "VZDRAK SMRNK - VYCHOD",
       description "The eastern section of the Bridge. Consoles line the walls.",
       w_to Bridge;
ArcheronRoom WestBridge "West Bridge"
  with zh_name "VZDRAK SMRNK - ZAPAD",
       description "The western section of the Bridge. Consoles line the walls. A sealed airlock leads east.",
       e_to Bridge;
! ArcheronRoom Airlock "Escape Pod Airlock"
!  with zh_name "ZAMER SMRNK",
 
