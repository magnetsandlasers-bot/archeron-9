[ Initialise;
    SetupSelf();          ! Set up the selfobj description and scope
    location = CryoBay;
    notify_mode = false; ! Suppress the "score has gone up" message
    move HighTechJumpsuit to CryoBay;
    move Keycard to Corpse;
    move ExitButton to Engineering;
    move Battery1 to CryoBay;
    move Battery2 to BatteryShelf;
    move Battery3 to BatteryShelf;
    move Battery4 to BatteryShelf;
    move ChargedCell5 to DroneCharger;
    move DiagnosticConsole to MedicalBay;
    move MedicalLogTerminal to MedicalBay;
    move OperatingTable to MedicalBay;
    move BrokenDrone to DroneBench;
    move AVModuleFried to BrokenDrone;
    move SecurityDrone1 to Atrium; 
    move AVModule1 to SecurityDrone1;
    move SecurityDrone2 to Hangar; 
    move AVModule2 to SecurityDrone2;
    move RetinalScanner to EquipmentShelf;
    move FluxCapacitor to EquipmentShelf;
    move JeeJah to EquipmentShelf;
    move SonicScrewdriver to EquipmentShelf;

    StartDaemon(SecurityDrone);
    StartDaemon(Arpi);

    ! --- Intro Sequence ---
    @erase_window $ffff;
    new_line;
    style underline;
    print "~Jadroz: veskrach... Domn: pohyb.~^";
    style roman;
    print "^As you wake, you find yourself already standing on a cold metal grate, your breath misting in the chill air. Having gently ejected you from its interior, the coffin-like pod behind you is already recalibrating for its next guest. You shiver as your skin dries, wicking away any residual heat you may have been holding. From all around you, a voice barks:^";
    jumpsuit_timer = 3; ! Put on jumpsuit in 3 turns or die
    move HighTechJumpsuit to CryoBay;
    ! --- Activate Alarm Lights ---
    alarm_lights_active = 1;
    new_line;
    style underline;
    print "~KRZHDYN: STAVR! DRAZKARY: ZAMEROSH!~^";
    style roman;
    new_line;
    Banner();
    print "^Press any key to begin... ";
    @read_char 1 -> sp;
    @erase_window $ffff; ! Clear screen for game start
    ! --- Pre-Game Urgency Text ---
    new_line;
    print "^Red alarm lights begin flashing! You hear the announcement again, and though you can't understand the strange words, you can tell they sound urgent.^";
    new_line;
    style underline;
    print "~KRZHDYN: STAVR! DRAZKARY: ZAMEROSH!~";
    style roman;
    new_line;
    return 2; ! Suppress banner, start game
];