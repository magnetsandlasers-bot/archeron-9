AftRoom CryoBay "Cryo Bay"
  with zh_name "VESKRAN ZRAAV",
       description [;
           print "The air is freezing here, stinging your exposed skin. There is a bank of empty, frosted glass tubes on the East wall. Most of them are open, like the one you just stepped out of. The only exit is a door leading North.";
           new_line;
           if (jumpsuit_timer > 0 && HighTechJumpsuit in self) {
               print "^A high-tech grey jumpsuit hangs next to the cryo-tube you just stepped out of. It looks warm, and just your size.^";
           }
           return true;
        ],
        n_to AftCorridor;
AftRoom TubeInterior "Inside the Cryo Tube"
    with description "It is cramped and smelly in here, but at least it's warm.",
        after [;
            give PlayerCryoTube ~open; ! The door slams shut behind them
            print "^Suddenly, the glass lid slides shut with the speed of a guillotine. The bolts engage with a sickening thud.^^";
            print "The lights go red and the floor vents hiss. You hear a strangely calm voice intones ",
                TranslateAudio("~TSKOR VZNIK. TSKOR VZNIK. ", "INCINERATION IMMINENT. INCINERATION IMMINENT. ");
            print "Before you can even scream, jets of white-hot plasma erupt from the wall-ports, turning the tube into a high-pressure incinerator and you into a pile of dust.^^";
           deadflag = 1;
           return true;
       ],
  has light;
AftRoom AftCorridor "Aft Corridor"
  with zh_name "POHYB STAVR SCERN",
       description [;
           print "A long, dark metal corridor. Emergency lights cast long shadows.^";
           if (BulkheadDoor has locked) {
               print "To the North, a massive bulkhead door blocks the passage.";
           } else {
               print "To the North, the bulkhead door stands open, leading deeper into the ship.";
           }
           print " To the East, a security door marked ";
           if (visual_cortex_active) {
               print "ENGINEERING is closed. An open archway leads West towards an area marked REACTOR. ";
           } else {
               print "KRZHDYN is closed. An open archway leads West towards an area marked JADROZ. ";
           };
           print "A desiccated corpse lies slumped against the wall.^";
           return true;
        ],
        s_to CryoBay, w_to ReactorRoom, n_to BulkheadDoor, e_to EngineeringDoor;
AftRoom Engineering "Engineering Room"
  with zh_name "KRZHDYN STAVR",
       description [;
           print "A claustrophobic little closet smelling of magic smoke and hot circuitry. Status panels of various sizes fill the walls. Cables and wires snake in and out, around and under them.";
           print " Looking at the panels, ";
           
           if (battery_count == 0) {
               print "you notice most of them are green, except for one status light next to a metal lever marked ";
            TranslateVisual("POHYB ZANER", "BULKHEAD CONTROL");
               ", which is glowing an ominous red.";  
           } 
           else if (battery_count == 1) {
               print "you notice one light next to a metal lever marked ";
            TranslateVisual("POHYB ZANER", "BULKHEAD CONTROL");
               " is flashing amber.";
           } 
           else {
               print "you see that all status lights are green, including the one next to the lever marked  ";
            TranslateVisual("POHYB ZANER.", "BULKHEAD CONTROL.");
           }
           print " A metal shelf is bolted to one wall. It looks cluttered with boxes, manuals, spare parts, and other detritus. The only exit is West.^";
           return true;
       ],
       w_to EngineeringDoor;

AftRoom ReactorRoom "Reactor Room"
  with zh_name "KRZHDAR JADROZ",
       description [;
           print "The air here smells of ozone. A complex mechanism is set into the north wall, and a massive column dominates the center of the room.";
           if (battery_count > 0) print " The column hums with a deep, bone-shaking rhythm.";
           else print " The room is silent and dark.";
           print " The exit lies to the East.^";
           return true;
        ],
        e_to AftCorridor;