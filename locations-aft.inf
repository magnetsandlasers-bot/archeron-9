AftRoom CryoBay "Cryo Bay"
  with zh_name "VESKRAN ZRAAV",
       description [;
           print "You are standing in front of a bank of glass-fronted pods. Most of them are open. One near you appears occupied. The only exit is a door leading north.";
           new_line;
           if (jumpsuit_timer > 0 && HighTechJumpsuit in self) {
               print "^A high-tech grey jumpsuit hangs next to the pod you just stepped out of. It looks warm.^";
           }
           return true;
        ],
        n_to AftCorridor;
AftRoom TubeInterior "Inside the pod"
    with description "It is cramped and smelly in here, but at least it's warm.",
        after [;
            give PlayerCryoTube ~open;
            print "^Suddenly, the glass lid slides shut with the speed of a guillotine. A series of bolts shoot into place, sealing you in.^^";
            print "The lights go red and the floor vents hiss. A strangely calm voice intones ",
                TranslateAV("~TSKOR VZNIK. TSKOR VZNIK. ", "INCINERATION IMMINENT. INCINERATION IMMINENT. ");
            print "Before you can even scream, jets of white-hot plasma erupt from the wall-ports, turning the tube into a high-pressure incinerator and you into a pile of dust.^^";
           deadflag = 1;
           return true;
       ],
  has light;
AftRoom AftCorridor "Aft Corridor"
  with zh_name "POHYB STAVR SCERN",
       description [;
           print "A long, dark metal corridor. ";
           if (power_restored == 0) {
               print "Emergency lights cast long shadows.^";
           } else {
               print "^";
           }
           if (BulkheadDoor has locked) {
               print "To the North, a massive bulkhead door blocks the passage.";
           } else {
               print "To the North, the bulkhead door stands open, leading deeper into the ship.";
           }
           print " To the East, a security door marked ";
           if (AV_codec_active) {
               print "ENGINEERING is closed. An open archway leads West towards an area marked REACTOR. ";
           } else {
               print "KRZHDYN is closed. An open archway leads West towards an area marked JADROZ. ";
           };
           print "A desiccated corpse lies slumped against the wall.^";
           return true;
        ],
        s_to CryoBay, w_to ReactorRoom, n_to BulkheadDoor, e_to EngineeringDoor;
AftRoom Engineering "Engineering Room"
  with zh_name "KRZHDYN STAVR",
       description [;
           print "A claustrophobic little room with a tiny workbench and shelf. Display panels of all sizes line the walls. Cables and wires snake in and out, around and under them.";
           print " Looking at the panels, ";
           
           if (identity_hacked == 0) {
               print "you see only dull static crackling across all of them.";
           }
           else if (battery_count == 1) {
               print "you notice one light next to a metal lever marked ";
            TranslateAV("POHYB ZANER", "BULKHEAD CONTROL");
               " is flashing amber.";
           } 
           else {
               print "you see that all status lights are green, including the one next to the lever marked  ";
            TranslateAV("POHYB ZANER.", "BULKHEAD CONTROL.");
           }
           print " A metal shelf is bolted to one wall. It looks cluttered with boxes, manuals, spare parts, and other detritus. The only exit is West.^";
           return true;
       ],
       w_to EngineeringDoor;

AftRoom ReactorRoom "Reactor Room"
  with zh_name "KRZHDAR JADROZ",
       description [;
           if (power_restored == 0)
               print "This circular room is cramped and stuffy, lit only with emergency lights at shin level. You can make out some kind of console set into the wall, and a massive column with a similar console dominates the center of the room. You appear to be standing on a metal grate. You can barely see dim, static shapes hanging in the air above you.";
           else
               print "This circular room is lit from above, and hums with energy. A console is set into the wall, and a massive column with a similar console dominates the center of the room. The column twinkles with status lights, indicating steady activity. You are standing on a metal grate above a den of snaking, pulsing cables and wires. Above you, the column sends out branches in every direction, connecting all parts of the ship.";
           
           if (battery_count == 1)
               print " A ring of status panels line the wall just above eye level. Some status panels have turned from red to green.";
           else if (battery_count == 2)
               print " A ring of status panels line the wall just above eye level. Most are glowing green, but a few outliers remain in the red.";
           else if (battery_count >= 3)
               print " A ring of status panels line the wall just above eye level. The status panels are all green.";
           else
               print " The room is silent and still.";
           
           print " The exit lies to the East.^";
           return true;
        ],
        e_to AftCorridor;