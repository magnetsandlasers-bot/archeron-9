! ==============================================================================
! Custom Verbs
! ==============================================================================

Verb 'install' 'slot' * held -> Install;
Extend 'insert'       * held -> Install;

Verb 'blink'
    * -> Blink
    * 'twice' -> BlinkTwice;

Verb 'freeze' 'stop' * -> Freeze;
Verb 'hide' 'duck'   * -> Hide;
Verb 'recall'        * noun -> Recall;

! Developer Tools
Verb 'dev' 'stats' 'diag' * -> DevMenu;
Verb 'warp' 'goto' * topic -> Warp;
Verb 'heal' * -> Heal;
Verb 'toggle' 
    * topic -> Toggle;

! Swipe Keycard
Verb 'swipe'
    * held                               -> Swipe
    * held 'at'/'through'/'on'/'in' noun -> Unlock reverse;

! Add 'swipe' to the existing Unlock grammar so "swipe card at door" works
Extend 'unlock' first
    * held 'at'/'through'/'on' noun      -> Unlock reverse;