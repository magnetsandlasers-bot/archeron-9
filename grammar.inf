! ==============================================================================
! GRAMMAR & INIT
! ==============================================================================
! Include "grammar";
Verb 'install' 'slot' * noun -> Install;
Extend 'insert' * noun -> Install;
Verb 'blink'
    * -> Blink
    * 'twice' -> BlinkTwice;
Verb 'freeze' 'stop' * -> Freeze;
Verb 'hide' 'duck' * -> Hide;
Verb 'recall' * noun -> Recall;

! ==============================================================================
! GRAMMAR.INF - Custom Verbs
! ==============================================================================

Verb 'dev' 'stats' 'diag' * -> DevMenu;

Verb 'warp' 'teleport' 'goto' * [AnyRoom] -> Warp;

Verb 'heal' * -> Heal;

Verb 'toggle' * [special] -> Toggle;