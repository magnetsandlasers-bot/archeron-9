! Room Classes
Class ArcheronRoom 
    with short_name [;
    if (AV_codec_active == 0 && self provides zh_name) {
        print (string) self.zh_name; rtrue;
    }
    rfalse;
    ], 
    arpi_access 1,
    arpi_spoken 0, ! 0 means he hasn't spoken yet
    has light;
Class Corridor 
    with short_name [;
    if (AV_codec_active == 0 && self provides zh_name) {
        print (string) self.zh_name; rtrue;
    }
    rfalse;
        ],
        arpi_access 1,
        arpi_spoken 0, ! 0 means he hasn't spoken yet
        hide_spot "quickly press yourself against the wall, avoiding the scan.",
    has light;
Class AftRoom 
    with short_name [;
    if (AV_codec_active == 0 && self provides zh_name) {
        print (string) self.zh_name; rtrue;
    }
    rfalse;
    ],
        arpi_access 1,
        arpi_spoken 0, ! 0 means he hasn't spoken yet
        hide_spot "dive into the nearest shadow, holding your breath.", 
    has light;
Class ServerFarm 
    with short_name [;
    if (AV_codec_active == 0 && self provides zh_name) {
        print (string) self.zh_name; rtrue;
    }
    rfalse;
    ],
    before [;
        Go:
            if (noun == se_obj && arpi_shortcut_active == 1) {
                arpi_shortcut_active = 0; ! Reset it so they have to ask again
                "Following Arpi's lead, you slip through a gap between the humming server racks...^^",
                (PlayerTo) ServerTerminalRoom;
            }
    ],
    arpi_access 1,
    arpi_spoken 0, ! 0 means he hasn't spoken yet
    hide_spot "realize there is no place to hide from anyone here, including yourself", 
    has light;
Class CrawlSpace
    with 
    arpi_access 1,
    arpi_spoken 0, ! 0 means he hasn't spoken yet
    arpi_hint ArpiCrawlHint,
    hide_spot "cannot be serious.", 
        has light;
! Object Classes
Class SecurityDrone
  with name 'drone' 'robot' 'machine' 'sphere', 
       description [;
           if (self.is_active == 1) 
               "A floating sphere of black metal with a glowing red eye.";
           "An inert sphere of black metal. Its red eye is dark. Its carapace has a seam down the middle, which looks like it could be opened fairly easily.";
       ],
       describe [ other_drone;  
    ! 1. Silence drones in the workshop
    if (location == DroneWorkshop) rtrue;
    ! 2. Identify the "other" drone
    other_drone = SecurityDrone1;
    if (self == SecurityDrone1) other_drone = SecurityDrone2;

    ! 3. Handle the "Paired" logic (only if both are in the same room)
    if (parent(other_drone) == parent(self)) {
        ! If both are in the room, only the first drone speaks
        if (self == SecurityDrone2) rtrue; 

        if (self.is_active == 1 && other_drone.is_active == 1)
            "Two security drones hover here, their red eyes scanning the room.";
        
        "A live security drone hovers here, examining its fallen comrade.";
    }

    ! 4. Handle the "Single" logic (if only one drone is present)
    if (self.is_active == 1) 
        "A security drone hovers here, scanning for thermal signatures."; 
    "A dead security drone lies on the floor.";
        ],
       initial [;
           ! --- WORKSHOP SILENCE ---
           if (location == DroneWorkshop) rtrue;

           if (self.is_active == 1) "A Security Drone hovers here, scanning for thermal signatures.";
           "A dead security drone lies here.";
       ],
       move_count 0,
       is_active 1, 
       drone_alert 0,
       before [;
            Open:
                if (self.is_active == 1) {
                    "You consider grabbing the drone right out of the air, but think the better of it. You've just gotten used to having fingers.";
                }
       ],
  has static container openable;

Class AVModule
  with  name 'chip' 'module' 'silver' 'wafer' 'sliver' 'patch',
        bulk BULK_POCKET,
        parent_drone 0,
        description [;
            print "A sleek, silver wafer, thin as a coin and slightly concave. ";
            if (self.parent_drone ~= 0) 
                "It's currently mounted to a drone chassis.";
            "The inner surface is perfectly smooth, designed to bond directly to your temple.";
        ],
        before [;
            Wear: <<Install self>>;
            Take:
                move self to player;
                ! Trigger the Crawl tutorial if Arpi isn't active yet
                if (arpi_aware == 0) {
                    print "As you pick up the silver wafer, one of the nearby Crawls pauses its scavenging. It tilts its chassis toward you, pointing a manipulator arm first at the chip in your hand and then—with a sharp, mechanical click—to the side of its own rusted sensor-head. It holds the pose for a second before skittering back into the shadows.^";
                } else {
                    print "You pick up the silver wafer.^";
                }
                
                if (self.parent_drone ~= 0) {
                    DisassembleDrone(self.parent_drone);
                }
                rtrue;
            Install:
                if (AV_codec_active == 1) { 
                    print "You hold the wafer to your head, but it remains cold and inert. Your neural link is already occupied.^"; 
                    rtrue; 
                }
                print "You press the silver wafer to your temple. It flushes with a brief, sharp heat as it bonds to your skin. The edges seem to melt into your hairline, and a low, resonant vibration spreads through your skull.^";
                
                if (arpi_aware == 1) {
                    print "^~We're back!~ Arpi's voice resonates clearly. ~I thought I lost you when that last module slagged out.~^";
                } 
                else {
                    arpi_aware = 1;
                    print "^~Link successful!~ a new voice chimes in your mind, crisp and steady. ~I'm Arpi. We're going to have to trust each other if we're getting off this ship.~^";
                }
                achieved(6); 
                AV_codec_active = 1;
                installed_chip = self;
                StartDaemon(self);
                remove self; 
                rtrue;
        ];
Class Battery
         with name 'cell' 'battery' 'cylinder' 'heavy' 'dark' 'batteries//p' 'cells//p' 'cylinders//p',
     short_name "dark cell",
     plural "dark cells",
     description "A heavy, dark cylindrical object. A recessed groove runs around its middle.",
    charged 0, shelvable 1,     
    bulk BULK_HEAVY;
Class ChargedBattery
    with name 'cylinder' 'canister' 'heavy' 'unit' 'battery' 'pulsing' 'cell' 'batteries//p' 'cells//p' 'cylinders//p',
    short_name "pulsing cell",
    plural "pulsing cells",
    description "The cylindrical object has come to life! Blue light pulses from the recessed groove, and the casing feels warm.",
    charged 1, shelvable 1,
    bulk BULK_HEAVY;
