! Room Classes
Class ArcheronRoom 
    with short_name [;
    if (AV_codec_active == 0 && self provides zh_name) {
        print (string) self.zh_name; rtrue;
    }
    rfalse;
    ], 
    arpi_access 1,
    arpi_spoken 0, ! 0 means he hasn't spoken yet
    has light;
Class Corridor 
    with short_name [;
    if (AV_codec_active == 0 && self provides zh_name) {
        print (string) self.zh_name; rtrue;
    }
    rfalse;
        ],
        arpi_access 1,
        arpi_spoken 0, ! 0 means he hasn't spoken yet
        hide_spot "quickly press yourself against the wall, avoiding the scan.",
    has light;
Class AftRoom 
    with short_name [;
    if (AV_codec_active == 0 && self provides zh_name) {
        print (string) self.zh_name; rtrue;
    }
    rfalse;
    ],
        arpi_access 1,
        arpi_spoken 0, ! 0 means he hasn't spoken yet
        hide_spot "dive into the nearest shadow, holding your breath.", 
    has light;
Class ServerFarm 
    with short_name [;
    if (AV_codec_active == 0 && self provides zh_name) {
        print (string) self.zh_name; rtrue;
    }
    rfalse;
    ],
    before [;
        Go:
            if (noun == se_obj && arpi_shortcut_active == 1) {
                arpi_shortcut_active = 0; ! Reset it so they have to ask again
                "Following Arpi's lead, you slip through a gap between the humming server racks...^^",
                (PlayerTo) ServerTerminalRoom;
            }
    ],
    arpi_access 1,
    arpi_spoken 0, ! 0 means he hasn't spoken yet
    hide_spot "realize there is no place to hide from anyone here, including yourself", 
    has light;
Class CrawlSpace
    with 
    arpi_access 1,
    arpi_spoken 0, ! 0 means he hasn't spoken yet
    arpi_hint ArpiCrawlHint,
    hide_spot "cannot be serious.", 
        has light;
! Object Classes
Class SecurityDrone
  with name 'drone' 'robot' 'machine' 'sphere', 
       description [;
           if (self.is_active == 1) 
               "A floating sphere of black metal with a glowing red eye.";
           "An inert sphere of black metal. Its red eye is dark. Its carapace has a seam down the middle, which looks like it could be opened fairly easily.";
       ],
       describe [ other_drone;  
    ! 1. Silence drones in the workshop
    if (location == DroneWorkshop) rtrue;
    ! 2. Identify the "other" drone
    other_drone = SecurityDrone1;
    if (self == SecurityDrone1) other_drone = SecurityDrone2;

    ! 3. Handle the "Paired" logic (only if both are in the same room)
    if (parent(other_drone) == parent(self)) {
        ! If both are in the room, only the first drone speaks
        if (self == SecurityDrone2) rtrue; 

        if (self.is_active == 1 && other_drone.is_active == 1)
            "Two security drones hover here, their red eyes scanning the room.";
        
        "A live security drone hovers here, examining its fallen comrade.";
    }

    ! 4. Handle the "Single" logic (if only one drone is present)
    if (self.is_active == 1) 
        "A security drone hovers here, scanning for thermal signatures."; 
    "A dead security drone lies on the floor.";
        ],
       initial [;
           ! --- WORKSHOP SILENCE ---
           if (location == DroneWorkshop) rtrue;

           if (self.is_active == 1) "A Security Drone hovers here, scanning for thermal signatures.";
           "A dead security drone lies here, trailing a thin wisp of smoke.";
       ],
       move_count 0,
       is_active 1, 
       drone_alert 0,
       before [;
            Open:
                if (self.is_active == 1) {
                    "You consider grabbing the drone right out of the air, but think the better of it. You've just gotten used to having fingers.";
                }
       ],
  has static container openable;

Class AVModule
  with  name 'chip' 'module' 'silver' 'wafer',
        bulk BULK_POCKET,
        description "A sleek silver bio-chip. It looks like a standard codec processor.",
        before [;
            Wear: <<Install self>>;
            Install:
                if (AV_codec_active == 1) { 
                    print "You hear a tiny buzzer sound and the chip refuses to insert.^"; 
                    rtrue; 
                }

                ! --- NEW LOGIC START ---
                if (arpi_aware == 1) {
                    print "You slide the chip in. A familiar rhythmic pulsing begins, then settles. 
                    ~We're back!~ Arpi's voice sounds clearer than before, relieved. ~I thought I lost you when that last module slagged out.~^";
                } 
                else {
                    arpi_aware = 1; ! Now they are aware
                    print "You slide the chip in. Your neural link integrates the data stream. 
                    ~Link successful!~ a new voice chimes in your mind. ~I'm Arpi. We're going to have to trust each other if we're getting off this ship.~^";
                }
                ! --- NEW LOGIC END ---

                achieved(6); 
                AV_codec_active = 1;
                installed_chip = self;
                StartDaemon(self); ! Ensure the daemon starts for standard chips too
                remove self; 
                rtrue;
        ];
Class Battery
         with name 'cell' 'battery' 'cylinder' 'heavy' 'dark' 'batteries//p' 'cells//p' 'cylinders//p',
     short_name "dark cylinder",
     plural "dark cylinders",
     description "A heavy, dark cylinder. A recessed groove runs around its middle.",
    charged 0, shelvable 1,     
    bulk BULK_HEAVY;
Class ChargedBattery
    with name 'cylinder' 'canister' 'heavy' 'unit' 'battery' 'pulsing' 'cell' 'batteries//p' 'cells//p' 'cylinders//p',
    short_name "pulsing cylinder",
    plural "pulsing cylinders",
    description "The cylinder has come to life. Blue light pulses from the recessed groove, and the casing feels warm.",
    charged 1, shelvable 1,
    bulk BULK_HEAVY;