AlienRoom CargoBay "Cargo Bay"
  with zh_name "VZDYK DRAZK",
       description "A dark, cavernous storage area. The exit is Up.", u_to Atrium;
Object -> CargoCrates "crates" with name 'crate' 'crates', description "Standard shipping crates.", has static scenery;
Object -> DataWafer "data wafer"
  with name 'wafer' 'disk' 'chip' 'admin', bulk BULK_POCKET,
       description [; print "A small data chip. Label: "; PrintVisual("ZRAAVEK: VZ-STYRZ"); print ".^"; return true; ];
