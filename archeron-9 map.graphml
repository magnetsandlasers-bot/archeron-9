    <edge source="CryoBay" target="Corridor"/>
    <edge source="Corridor" target="ReactorRoom"/>
    <edge source="Corridor" target="Engineering"/>
    <edge source="Corridor" target="SpineFore">
      <data key="d10"><y:PolyLineEdge><y:EdgeLabel>Bulkhead Door</y:EdgeLabel></y:PolyLineEdge></data>
    </edge>
    <edge source="SpineFore" target="SpineMid"/>
